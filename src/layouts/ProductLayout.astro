---
import Layout from './Layout.astro';

const {
  title,
  description = "Industrial static control and surface cleaning equipment by Shidike.",
  image = "/assets/img/header-bg.jpg",
  sku = "",
  category = "Industrial Equipment",
} = Astro.props;

const productName = title.split('|')[0].trim();
const _rawHref = Astro.url.href;
const canonical = Astro.url.pathname === '/' ? _rawHref : _rawHref.replace(/\/$/, '');
const base = "https://www.dg-sdk.com";

// Build breadcrumb from URL path
const pathParts = new URL(canonical).pathname.replace(/\/$/, '').split('/').filter(Boolean);
const categoryLabels: Record<string, string> = {
  'products': 'Products',
  'static-eliminator': 'Static Eliminator',
  'cleaning-machine': 'Cleaning Machine',
  'automation': 'Automation Equipment',
};
const breadcrumbItems = [
  { name: 'Home', url: base },
  ...pathParts.map((part, i) => ({
    name: categoryLabels[part] || productName,
    url: `${base}/${pathParts.slice(0, i + 1).join('/')}`,
  })),
];
---

<Layout title={title} description={description} image={image}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": breadcrumbItems.map((item, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "name": item.name,
      "item": item.url,
    }))
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ItemPage",
    "@id": canonical,
    "url": canonical,
    "name": productName,
    "description": description,
    "primaryImageOfPage": {
      "@type": "ImageObject",
      "url": `https://www.dg-sdk.com${image}`
    },
    "keywords": category,
    "identifier": sku || productName.replace(/\s+/g, '-').toLowerCase(),
    "inLanguage": "en",
    "publisher": { "@id": "https://www.dg-sdk.com/#organization" }
  })} />

  <!-- 内容 -->
  <main class="product-main">
    <slot />
  </main>

  <!-- Product quote modal. The only lead-capture UI on a product page, so it
       carries the page's own context: which product, which model, and which of
       the three buttons was used. Page and product only — no personal field is
       added here. -->
  <div class="quote-modal" id="quoteModal" role="dialog" aria-modal="true" aria-labelledby="quoteModalTitle">
    <div class="quote-modal-overlay" id="closeQuoteModal"></div>

    <div class="quote-modal-content">
      <button class="quote-modal-close" id="closeQuoteModalBtn" type="button" aria-label="Close quote form">×</button>

      <h2 id="quoteModalTitle">Get a Quote</h2>
      <p>
        If you have any questions about this product, please leave your contact
        details and we will get back to you as soon as possible.
      </p>

      <form class="quote-form" id="quoteFormProduct" action="https://formspree.io/f/mvzlpdwy" method="POST">
        <input type="text" name="website" style="display:none" tabindex="-1" autocomplete="off" />
        <input type="hidden" name="_subject" value={`Product enquiry — ${productName}`} />
        <input type="hidden" name="source" value="product-page" />
        <input type="hidden" name="product" value={productName} />
        {sku && <input type="hidden" name="model" value={sku} />}
        <input type="hidden" name="page" value={canonical} />
        <input type="hidden" name="entry" id="quoteEntry" value="" />
        <input type="text" name="name" placeholder="Your Name" required />
        <input type="email" name="email" placeholder="Your Email" required />
        <input type="text" name="phone" placeholder="Your Phone" />
        <textarea name="message" rows="5" placeholder="Your Message"></textarea>
        <button type="submit">Send Message</button>
      </form>
    </div>
  </div>

  <!-- 全站通用图片放大 -->
  <div class="image-lightbox" id="imageLightbox">
    <div class="image-lightbox-overlay" id="closeImageLightbox"></div>
    <div class="image-lightbox-content">
      <button class="image-lightbox-close" id="closeImageLightboxBtn" type="button">×</button>
      <img id="lightboxImage" alt="Zoomed product image" loading="lazy" />
    </div>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      // ===== Quote Modal =====
      const quoteModal = document.getElementById('quoteModal');
      const closeQuoteOverlay = document.getElementById('closeQuoteModal');
      const closeQuoteBtn = document.getElementById('closeQuoteModalBtn');
      const quoteEntry = document.getElementById('quoteEntry');
      // Where focus came from, so it can go back when the dialog closes.
      let quoteOpener = null;

      const FOCUSABLE = 'a[href], button:not([disabled]), input:not([disabled]):not([type="hidden"]), select, textarea, [tabindex]:not([tabindex="-1"])';

      function openQuote(opener) {
        if (!quoteModal) return;
        quoteOpener = opener || null;
        // Three buttons open this one form — "Get a Quote", "Ask an Engineer"
        // and "Request a Quote". Record which, so an enquiry says where on the
        // page it started. The label only, nothing the visitor typed.
        if (quoteEntry) quoteEntry.value = opener ? (opener.textContent || '').trim().slice(0, 60) : '';
        quoteModal.classList.add('active');
        document.body.style.overflow = 'hidden';
        const first = quoteModal.querySelector('input:not([type="hidden"]):not([tabindex="-1"]), textarea');
        if (first) first.focus();
      }

      function closeQuote() {
        if (!quoteModal) return;
        quoteModal.classList.remove('active');
        document.body.style.overflow = '';
        if (quoteOpener && document.contains(quoteOpener)) quoteOpener.focus();
        quoteOpener = null;
      }

      document.querySelectorAll('.quote-btn').forEach((btn) => {
        btn.addEventListener('click', () => openQuote(btn));
      });

      if (closeQuoteOverlay) closeQuoteOverlay.addEventListener('click', closeQuote);
      if (closeQuoteBtn) closeQuoteBtn.addEventListener('click', closeQuote);

      // Escape closed nothing before this, and Tab walked out of the dialog
      // into the page behind it.
      document.addEventListener('keydown', (e) => {
        if (!quoteModal || !quoteModal.classList.contains('active')) return;
        if (e.key === 'Escape') { closeQuote(); return; }
        if (e.key !== 'Tab') return;
        const items = Array.from(quoteModal.querySelectorAll(FOCUSABLE))
          .filter((el) => el.offsetParent !== null || el === document.activeElement);
        if (!items.length) return;
        const first = items[0];
        const last = items[items.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
      });

      // ===== Main Product Gallery Slider =====
      const mainImage = document.getElementById('mainProductImage');
      const thumbs = document.querySelectorAll('.thumb-image');
      const prevBtn = document.getElementById('prevImage');
      const nextBtn = document.getElementById('nextImage');
      const thumbsWrap = document.querySelector('.product-thumbs');

      if (mainImage) {
        const imageList = Array.from(thumbs)
          .map((thumb) => thumb.dataset.full)
          .filter(Boolean);

        let currentIndex = 0;

        // The main image sits inside a <picture>. A matching <source> outranks
        // the <img>, so setting mainImage.src alone changed nothing — the
        // browser kept painting the first <source>. Update (or drop) the
        // source too, and fall back to the raw file if the .webp is absent.
        const mainPicture = mainImage.closest('picture');
        function setMainSource(url) {
          if (!mainPicture) { mainImage.src = url; return; }
          const source = mainPicture.querySelector('source');
          const webp = url.replace(/\.(jpe?g|png)$/i, '.webp');
          if (source && webp !== url) {
            source.srcset = webp;
            mainImage.onerror = () => {
              mainImage.onerror = null;
              source.remove();
              mainImage.src = url;
            };
          } else if (source) {
            source.remove();
          }
          mainImage.src = url;
        }

        function updateMainImage(index) {
          if (!imageList.length) return;
          currentIndex = index;
          setMainSource(imageList[index]);

          thumbs.forEach((thumb, i) => {
            if (i === index) {
              thumb.classList.add('active-thumb');
            } else {
              thumb.classList.remove('active-thumb');
            }
          });
        }

        if (imageList.length > 0) {
          updateMainImage(0);
        }

        thumbs.forEach((thumb, index) => {
          thumb.addEventListener('click', () => {
            updateMainImage(index);
          });
        });

        if (prevBtn && nextBtn) {
          if (imageList.length <= 1) {
            prevBtn.style.display = 'none';
            nextBtn.style.display = 'none';
          } else {
            prevBtn.addEventListener('click', () => {
              const newIndex = currentIndex === 0 ? imageList.length - 1 : currentIndex - 1;
              updateMainImage(newIndex);
            });

            nextBtn.addEventListener('click', () => {
              const newIndex = currentIndex === imageList.length - 1 ? 0 : currentIndex + 1;
              updateMainImage(newIndex);
            });
          }
        }

        if (thumbsWrap && imageList.length <= 1) {
          thumbsWrap.style.display = 'none';
        }
      }

      // ===== Image Lightbox =====
      const imageLightbox = document.getElementById('imageLightbox');
      const lightboxImage = document.getElementById('lightboxImage');
      const closeImageOverlay = document.getElementById('closeImageLightbox');
      const closeImageBtn = document.getElementById('closeImageLightboxBtn');

      if (mainImage && imageLightbox && lightboxImage) {
        mainImage.style.cursor = 'zoom-in';
        mainImage.addEventListener('click', () => {
          lightboxImage.src = mainImage.src;
          imageLightbox.classList.add('active');
        });
      }

      if (closeImageOverlay && imageLightbox) {
        closeImageOverlay.addEventListener('click', () => {
          imageLightbox.classList.remove('active');
        });
      }

      if (closeImageBtn && imageLightbox) {
        closeImageBtn.addEventListener('click', () => {
          imageLightbox.classList.remove('active');
        });
      }

      // ===== Related Products Slider =====
      document.querySelectorAll('.related-slider-wrap').forEach((wrap) => {
        const track = wrap.querySelector('.related-slider-track');
        const prev = wrap.querySelector('.related-slider-prev');
        const next = wrap.querySelector('.related-slider-next');
        const currentKey = wrap.dataset.current;

        if (!track) return;

        // 隐藏当前产品
        if (currentKey) {
          track.querySelectorAll('.related-slide-card').forEach((card) => {
            if (card.dataset.key === currentKey) {
              card.style.display = 'none';
            }
          });
        }

        const scrollAmount = 320;

        if (prev) {
          prev.addEventListener('click', () => {
            track.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
          });
        }

        if (next) {
          next.addEventListener('click', () => {
            track.scrollBy({ left: scrollAmount, behavior: 'smooth' });
          });
        }
      });

      // ===== Quote Form Submission =====
      const quoteForm = document.getElementById('quoteFormProduct');
      if (quoteForm) {
        quoteForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          const honeypot = quoteForm.querySelector('input[name="website"]');
          if (honeypot && honeypot.value !== '') return;
          const btn = quoteForm.querySelector('button[type="submit"]');
          if (btn) btn.disabled = true;
          try {
            const res = await fetch('https://formspree.io/f/mvzlpdwy', {
              method: 'POST',
              body: new FormData(quoteForm),
              headers: { 'Accept': 'application/json' }
            });
            if (res.ok) {
              alert('Message sent! We will contact you shortly.');
              closeQuote();
              quoteForm.reset();
            } else {
              alert('Error sending message. Please try again.');
            }
          } catch(err) {
            alert('Error sending message. Please try again.');
          } finally {
            if (btn) btn.disabled = false;
          }
        });
      }
    });
  </script>

</Layout>
