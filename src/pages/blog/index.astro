---
// Blog index, rebuilt to the confirmed resource-page layout.
//
// The title, meta description, canonical and both JSON-LD blocks are the ones
// this page already published and are unchanged. The H1 also keeps its existing
// wording — the design shows a short "Blog", but this page is indexed on the
// longer heading, so the layout is adopted and the words are not.
//
// Every post is listed. The filter chips only hide cards that are already in
// the HTML; nothing here is built by script.
import Layout from '../../layouts/Layout.astro';
import ResourceIndex from '../../components/ResourceIndex.astro';
import ResourceFeature from '../../components/ResourceFeature.astro';
import ResourceGrid from '../../components/ResourceGrid.astro';
import { posts, featuredPost, categoriesOf } from '../../data/resources.js';

const base = 'https://www.dg-sdk.com';
const canonical = base + '/blog';

const items = posts.map((p) => ({ ...p, href: '/blog/' + p.slug }));
const featured = items.find((p) => p.slug === featuredPost) || items[0];
const rail = items.filter((p) => p !== featured).slice(0, 3);
---

<Layout
  title="Static Eliminator & Web Cleaning Technical Blog | Shidike"
  description="Practical guides on specifying, mounting and verifying anti static bars, ionizing air blowers and contact cleaning machines on real production lines."
>
  <link slot="head" rel="stylesheet" href="/css/resource-pages.css" />

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: base },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: canonical }
    ]
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: 'Shidike Technical Blog',
    url: canonical,
    description: 'Guides on specifying, mounting and verifying anti static bars, ionizing air blowers and contact cleaning machines.',
    publisher: { '@type': 'Organization', name: 'Shidike', url: base },
    blogPost: posts.map(p => ({
      '@type': 'BlogPosting',
      headline: p.title,
      description: p.excerpt,
      url: canonical + '/' + p.slug,
      image: base + p.image + '.jpg',
      datePublished: '2026-09-01'
    }))
  })} />

  <ResourceIndex
    eyebrow="Resources · Blog"
    heading="Static Eliminators & Web Cleaning, Explained"
    lead="Application articles on selecting, installing and verifying static-control and cleaning equipment for a production line."
    crumb="Blog"
    active="blog"
    cta={{
      heading: 'Looking for the fundamentals?',
      text: 'Our Guides explain ionizing bars, static prevention and web-cleaning methods.',
      label: 'Browse Guides',
      href: '/guides',
    }}
  >
    <ResourceFeature
      featured={featured}
      rail={rail}
      image="/assets/img/guides/ionizing-bar-action"
      kicker="Featured blog article"
      caption="Ionizing-bar application illustration from our technical guide."
      ctaLabel="Read the ST-G article"
    />

    <ResourceGrid
      eyebrow="Explore by topic"
      heading="All Blog articles."
      lead={`Explore equipment selection and application planning in these ${items.length} articles.`}
      items={items}
      categories={categoriesOf(items)}
      kind="Blog"
    />
  </ResourceIndex>
</Layout>
