---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact Shidike | Static Eliminator & Cleaning Machine Inquiry" description="Contact Shidike for anti static bars, ionizing air blowers and contact cleaning machines. Bar length made to order, machines built to your sample. Worldwide supply from Dongguan, China.">
  <section
    class="products-hero contact-hero-banner"
    style="background: linear-gradient(rgba(12, 24, 38, 0.58), rgba(12, 24, 38, 0.5)), url('/assets/img/contact/contact.jpg') center/cover no-repeat; background-attachment: scroll; background-image: linear-gradient(rgba(12, 24, 38, 0.58), rgba(12, 24, 38, 0.5)), image-set(url('/assets/img/contact/contact.webp') type('image/webp'), url('/assets/img/contact/contact.jpg') type('image/jpeg'));">
    <div class="container products-hero-inner">
      <span class="products-hero-kicker" data-aos="fade-down" data-aos-duration="600">Get in touch</span>
      <h1 data-aos="fade-up" data-aos-duration="700" data-aos-delay="100">Contact Shidike</h1>
      <p data-aos="fade-up" data-aos-duration="700" data-aos-delay="200">
        Send us the material, the line speed and the problem you are seeing. We will come back with a
        model, a bar length or a machine configuration &mdash; not a catalogue.
      </p>
    </div>
  </section>

  <section class="page-section contact-modern">
    <div class="container">
      <div class="contact-grid">
        <div class="contact-left">
          <h2>Talk to the people who build it</h2>

          <p class="company-name">Dongguan Shidike Intelligent Equipment Co., Ltd.</p>

          <p class="contact-desc">
            We focus on reliable static elimination systems and ionizing bars first,
            followed by precision cleaning machines for global customers. Please contact us for product
            information and cooperation opportunities.
          </p>

          <div class="response-guarantee">
            <i class="fas fa-clock"></i>
            <span>We respond to all inquiries within <strong>24 hours</strong> on business days.</span>
          </div>

          <h3>Direct contact</h3>

          <div class="contact-info-list">
            <div class="contact-info-item">
              <div class="contact-icon">
                <i class="fas fa-phone-alt"></i>
              </div>
              <div>
                <span class="contact-label">Cellphone:</span>
                <p>+86 13602342003</p>
              </div>
            </div>

            <div class="contact-info-item">
              <div class="contact-icon">
                <i class="fab fa-whatsapp"></i>
              </div>
              <div>
                <span class="contact-label">WhatsApp:</span>
                <p>+61 436605126</p>
              </div>
            </div>

            <div class="contact-info-item">
              <div class="contact-icon">
                <i class="fas fa-envelope"></i>
              </div>
              <div>
                <span class="contact-label">E-mail:</span>
                <p>dgsdk2013@gmail.com</p>
              </div>
            </div>

            <div class="contact-info-item">
              <div class="contact-icon">
                <i class="fas fa-map-marker-alt"></i>
              </div>
              <div>
                <span class="contact-label">Address:</span>
                <p>Room 101, Building 1, No. 33 Binhe Road, Zhangmutou Town, Dongguan, Guangdong, China</p>
              </div>
            </div>

            <div class="contact-social-block">
              <span class="contact-label">Follow Us</span>
              <div class="contact-social">
              <a href="https://www.facebook.com/profile.php?id=61589304230341" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="social-btn facebook"><i class="fab fa-facebook-f"></i></a>
              <a href="https://youtube.com/@dgsdk-2013" target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="social-btn youtube"><i class="fab fa-youtube"></i></a>
              <a href="https://www.tiktok.com/@machineforge?_r=1&_t=ZS-95scfOHz6Ea" target="_blank" rel="noopener noreferrer" aria-label="TikTok" class="social-btn tiktok"><i class="fab fa-tiktok"></i></a>
              <a href="https://wa.me/61436605126" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" class="social-btn whatsapp"><i class="fab fa-whatsapp"></i></a>
              <a href="mailto:dgsdk2013@gmail.com" target="_blank" rel="noopener noreferrer" aria-label="Email" class="social-btn email"><i class="fas fa-envelope"></i></a>
              </div>
            </div>
          </div>
        </div>

        <div class="contact-right">
          <div class="map-box">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3678.478825294075!2d113.76762507613407!3d22.784714925161143!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x34039625f048b6f7%3A0x20abebbe17b92cf2!2z5Lit5Zu95bm_5Lic55yB5Lic6I6e5biC5ruo5rKz6LevMzPlj7cg6YKu5pS_57yW56CBOiA1MjM4NTA!5e0!3m2!1szh-CN!2sus!4v1745226418103!5m2!1szh-CN!2sus"
              width="100%"
              height="100%"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"></iframe>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="page-section bg-light">
    <div class="container">
      <div class="text-center">
        <h2 class="section-heading text-uppercase">Send Inquiry</h2>
        <h3 class="section-subheading text-muted">
          Leave your message and we will reply within 24 hours on business days.
        </h3>
      </div>

      <div class="row justify-content-center">
        <div class="col-lg-8">
          <form action="https://formspree.io/f/mvzlpdwy" method="POST">
            <div class="form-group mb-3">
              <input class="form-control" type="text" name="name" placeholder="Your Name *" required />
            </div>

            <div class="form-group mb-3">
              <input class="form-control" type="email" name="email" placeholder="Your Email *" required />
            </div>

            <div class="form-group mb-3">
              <input class="form-control" type="text" name="company" placeholder="Company Name" />
            </div>

            <div class="form-group mb-3">
              <textarea class="form-control" name="message" rows="6" placeholder="Your Message *" required></textarea>
            </div>

            <div class="text-center">
              <button class="btn btn-primary btn-xl text-uppercase" type="submit">
                Send Message
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>

  <section class="category-info-block">
    <div class="container">
      <h2>Contact Shidike for Industrial Equipment Inquiries</h2>
      <p>
        Shidike (Dongguan Shidike Intelligent Equipment Co., Ltd.) manufactures anti static bars, ionizing
        air blowers and contact cleaning machines in Zhangmutou, Dongguan, Guangdong, China.
        We supply industrial customers worldwide and review both catalog-product and line-integration inquiries.
      </p>

      <h3>What We Can Help With</h3>
      <p>Our technical and sales team can assist with the following types of inquiries:</p>
      <ul>
        <li><strong>Static eliminators and ionizing bars</strong> — product selection, bar length, mounting distance, line speed, and control-interface review for specific production environments</li>
        <li><strong>PCB cleaning machines</strong> — circuit board cleaning machine specifications, model selection, and integration advice for SMT, FPC, and display manufacturing lines</li>
        <li><strong>Industrial cleaning machines</strong> — optical film, polarizer, LCM, backlight, and CCL cleaning solutions for display and electronics manufacturing</li>
        <li><strong>Line integration support</strong> — mounting, material handling, PLC signals, and interface review for static control and cleaning equipment</li>
      </ul>

      <h3>What to Include in Your Inquiry</h3>
      <p>
        To help us respond quickly and accurately, please include the following in your message:
      </p>
      <ul>
        <li>Product name or category you are interested in</li>
        <li>Substrate type, target width, dimensions, and material specifications</li>
        <li>Production volume or throughput requirements</li>
        <li>Application environment (SMT line, cleanroom, optical coating, etc.)</li>
        <li>Any layout drawings, photos, or technical files relevant to installation</li>
      </ul>

      <h3>Response and Lead Time</h3>
      <p>
        We respond to all inquiries within 24 hours on business days. For standard catalog products,
        we can provide pricing and lead time after confirming the model. For line-integration projects,
        we will review your requirements and provide a detailed proposal.
        Contact us by phone, WhatsApp, or email — or use the form above to send your inquiry directly.
      </p>
    </div>
  </section>

  <style>
    /* Banner: use the same .products-hero as every product, application and blog
       page (520px) instead of .contact-hero at 76vh. Photo background, so the
       type is reversed out to white. */
    .contact-hero-banner h1 { color: #fff !important; text-shadow: 0 2px 18px rgba(0,0,0,.4); }
    .contact-hero-banner p  { color: rgba(255,255,255,.9) !important; text-shadow: 0 1px 12px rgba(0,0,0,.35); }

    /* styles.css sized these at 56px and 48px -- larger than most H1s on the site,
       for what is a heading inside a two-column info panel. */
    .contact-left h2 { font-size: 1.75rem !important; margin-bottom: 12px !important; line-height: 1.25; }
    .contact-left h3 { font-size: 1.15rem !important; margin: 30px 0 4px !important; line-height: 1.3;
                       letter-spacing: .04em; text-transform: uppercase; color: #7d8d97 !important; }
    .contact-left .company-name { font-weight: 700; color: var(--navy); margin-bottom: 12px; }
    .contact-left .contact-desc { font-size: 15px; line-height: 1.7; color: var(--ink-muted); }
  </style>
</Layout>
