---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Static Eliminators & Ionizing Bars | Shidike"
  description="Intelligent static eliminators and ionizing bars with the high voltage generated inside the bar — no external power supply box. Made to length up to 3 m."
  image="/assets/img/static-eliminator/banner-bg2.webp"
>

  <!-- Structured Data -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": ["Organization", "LocalBusiness"],
    "name": "Shidike",
    "legalName": "Dongguan Shidike Intelligent Equipment Co., Ltd.",
    "alternateName": ["东莞史帝克智能装备有限公司", "DGSDK"],
    "numberOfEmployees": { "@type": "QuantitativeValue", "value": 50 },
    "url": "https://www.dg-sdk.com",
    "logo": { "@type": "ImageObject", "url": "https://www.dg-sdk.com/logo.png", "width": 600, "height": 168 },
    "image": "https://www.dg-sdk.com/assets/img/static-eliminator/banner-bg2.webp",
    "description": "Manufacturer of anti static bars, ionizing air blowers and web cleaning systems for electronics, SMT, film, packaging and display production lines.",
    "foundingDate": "2013",
    "address": { "@type": "PostalAddress", "streetAddress": "Binhai Road 33", "addressLocality": "Dongguan", "addressRegion": "Guangdong", "postalCode": "523000", "addressCountry": "CN" },
    "contactPoint": { "@type": "ContactPoint", "telephone": "+86-13602342003", "contactType": "sales", "availableLanguage": ["English", "Chinese"], "areaServed": "Worldwide" }
  }
  </script>

  <main id="main-content">

    <!-- HERO SECTION 1 — Main -->
    <section class="parallax-hero parallax-hero-1 hero-light">
      <div class="parallax-overlay"></div>
      <div class="container parallax-content" data-aos="fade-up" data-aos-duration="900">
        <p class="parallax-sub">Shidike · Industrial Static Control</p>
        <h1 class="parallax-heading">Intelligent Static Eliminators &amp; Ionizing Bars</h1>
        <p class="parallax-desc">No external power supply box, no fixed high-voltage cable. The high voltage is generated inside the bar from a 24 V DC supply, so it mounts where your line needs it — cut to the width of your material, up to 3 m. It also tells you when something is wrong: abnormal discharge raises an alarm and cuts the high voltage automatically.</p>
      </div>
    </section>

    <!-- Products -->
    <section class="page-section" id="services">
      <div class="container">
        <div class="text-center" data-aos="fade-up">
          <h2 class="section-heading text-uppercase">Our Core Products</h2>
          <p class="section-subheading text-muted">Anti static bars and anti static blowers for electrostatic charge; web cleaning systems for surface contamination.</p>
        </div>
        <div class="row text-center">
          <div class="col-lg-6 col-md-6 mb-4" data-aos="fade-up" data-aos-delay="0">
            <a href="/products/static-eliminator" class="product-card">
              <span class="fa-stack fa-4x product-icon"><i class="fas fa-circle fa-stack-2x text-primary"></i><i class="fas fa-bolt fa-stack-1x fa-inverse"></i></span>
              <h4>Anti Static Bars &amp; Ionizing Air Blowers</h4>
              <p>Our primary line: anti static bars on a 6.5 kV DC pulse, made to length up to 3 m, with ion balance from ±50 V, plus ionizing air blowers for benches and enclosures.</p>
            </a>
          </div>
          <div class="col-lg-6 col-md-6 mb-4" data-aos="fade-up" data-aos-delay="120">
            <a href="/products/cleaning-machine" class="product-card">
              <span class="fa-stack fa-4x product-icon"><i class="fas fa-circle fa-stack-2x text-primary"></i><i class="fas fa-soap fa-stack-1x fa-inverse"></i></span>
              <h4>Web Cleaning Systems &amp; Contact Cleaners</h4>
              <p>Our second line: dry-contact web cleaning systems and tacky rollers for PCB, FPC, SMT, polarizer, backlight, optical film and display substrates.</p>
            </a>
          </div>
        </div>
        <div class="text-center mt-4" data-aos="fade-up">
          <a href="/products/static-eliminator" class="btn btn-warning text-uppercase px-4 py-2">View Products</a>
        </div>
      </div>
    </section>

    <!-- Problems we fix -->
    <section class="page-section" id="problems">
      <div class="container">
        <div class="text-center" data-aos="fade-up">
          <h2 class="section-heading text-uppercase">What Static Is Costing You</h2>
          <p class="section-subheading text-muted">If any of these happen on your line, the cause is usually a surface charge nobody is measuring.</p>
        </div>

        <div class="fix-grid">
          <div class="fix-item" data-aos="fade-up" data-aos-delay="0">
            <h3>Dust comes back the moment you clean it</h3>
            <p>A charged surface pulls particles out of the air again within seconds. Cleaning alone never holds. Neutralize the charge first, then clean.</p>
            <span class="fix-fix">Anti static bar ahead of the cleaning station</span>
          </div>
          <div class="fix-item" data-aos="fade-up" data-aos-delay="60">
            <h3>Film and sheets stick, jam or misfeed</h3>
            <p>Charged material clings to itself and to the machine, so sheets double-feed, labels sit crooked and the web tracks off centre.</p>
            <span class="fix-fix">Ionizing bar at the unwind or infeed</span>
          </div>
          <div class="fix-item" data-aos="fade-up" data-aos-delay="120">
            <h3>Operators get shocks at the line</h3>
            <p>Charge builds on the material and discharges through whoever handles it. Unpleasant at best, and a real hazard around solvents.</p>
            <span class="fix-fix">Ionizing air blower at the workstation</span>
          </div>
          <div class="fix-item" data-aos="fade-up" data-aos-delay="180">
            <h3>Components fail after assembly, not before</h3>
            <p>Electrostatic discharge damages parts on SMT and PCB lines without leaving a mark, so the defect only shows up at final test.</p>
            <span class="fix-fix">Static control across the handling path</span>
          </div>
          <div class="fix-item" data-aos="fade-up" data-aos-delay="240">
            <h3>Stacks will not register or count correctly</h3>
            <p>Charged sheets repel or cling as they drop, so the stack fans out and automatic counting drifts at high speed.</p>
            <span class="fix-fix">Bar at the stacker, blower over the pile</span>
          </div>
          <div class="fix-item" data-aos="fade-up" data-aos-delay="300">
            <h3>You cannot tell whether it is fixed</h3>
            <p>Static problems get blamed on humidity, operators or the material supplier. A measured surface voltage before and after settles it.</p>
            <span class="fix-fix">Ion balance from ±50 V, measurable</span>
          </div>
        </div>

        <div class="text-center mt-4" data-aos="fade-up">
          <a href="/contact" class="btn btn-warning text-uppercase px-4 py-2">Describe Your Problem</a>
        </div>
      </div>
    </section>

    <!-- Applications -->
    <section class="page-section bg-light" id="portfolio">
      <div class="container">
        <div class="text-center" data-aos="fade-up">
          <h2 class="section-heading text-uppercase">Applications</h2>
          <p class="section-subheading text-muted">Where our anti static bars and web cleaning systems are installed, and what problem each one solves.</p>
        </div>
        <div class="row">
          <div class="col-lg-4 col-sm-6 mb-4" data-aos="fade-up" data-aos-delay="0">
            <a href="/applications" class="portfolio-item app-card">
              <div class="portfolio-link">
                <picture>
                  <source srcset="/assets/img/portfolio/1-700.webp 700w, /assets/img/portfolio/1.webp 1180w" sizes="(max-width: 768px) 100vw, 679px" type="image/webp" />
                  <picture><source srcset="/assets/img/portfolio/1.webp" type="image/webp" /><img class="img-fluid" src="/assets/img/portfolio/1.jpg" alt="Electronics Manufacturing" loading="lazy" width="679" height="509" /></picture>
                </picture>
              </div>
              <div class="portfolio-caption">
                <div class="portfolio-caption-heading">Electronics Manufacturing</div>
                <div class="portfolio-caption-subheading text-muted">Static control & cleaning solutions</div>
              </div>
            </a>
          </div>
          <div class="col-lg-4 col-sm-6 mb-4" data-aos="fade-up" data-aos-delay="100">
            <a href="/applications" class="portfolio-item app-card">
              <div class="portfolio-link">
                <picture>
                  <source srcset="/assets/img/portfolio/2-700.webp 700w, /assets/img/portfolio/2-900.webp 900w, /assets/img/portfolio/2.webp 1180w" sizes="(max-width: 768px) 100vw, 679px" type="image/webp" />
                  <picture><source srcset="/assets/img/portfolio/2.webp" type="image/webp" /><img class="img-fluid" src="/assets/img/portfolio/2.jpg" alt="SMT Production" loading="lazy" width="679" height="509" /></picture>
                </picture>
              </div>
              <div class="portfolio-caption">
                <div class="portfolio-caption-heading">SMT Production</div>
                <div class="portfolio-caption-subheading text-muted">Inline static control &amp; surface cleaning</div>
              </div>
            </a>
          </div>
          <div class="col-lg-4 col-sm-6 mb-4" data-aos="fade-up" data-aos-delay="200">
            <a href="/applications" class="portfolio-item app-card">
              <div class="portfolio-link">
                <picture>
                  <source srcset="/assets/img/portfolio/3-700.webp 700w, /assets/img/portfolio/3.webp 1180w" sizes="(max-width: 768px) 100vw, 679px" type="image/webp" />
                  <picture><source srcset="/assets/img/static-eliminator/st-g.webp" type="image/webp" /><img class="img-fluid" src="/assets/img/static-eliminator/st-g.jpg" alt="Ionizing bar for film and web processing" loading="lazy" width="679" height="509" /></picture>
                </picture>
              </div>
              <div class="portfolio-caption">
                <div class="portfolio-caption-heading">Film, Packaging &amp; Converting</div>
                <div class="portfolio-caption-subheading text-muted">Ionizing bars for moving materials and web lines</div>
              </div>
            </a>
          </div>
        </div>
        <div class="text-center mt-4" data-aos="fade-up">
          <a href="/contact" class="btn btn-warning text-uppercase px-4 py-2">Discuss Your Application</a>
        </div>
      </div>
    </section>

    <!-- About -->
    <section class="page-section" id="about">
      <div class="container">
        <div class="text-center" data-aos="fade-up">
          <h2 class="section-heading text-uppercase">About Shidike</h2>
          <p class="section-subheading text-muted">A manufacturer, not a trading company.</p>
        </div>
        <div class="about-grid">
          <article class="about-card" data-aos="fade-up" data-aos-delay="0">
            <picture>
              <source srcset="/assets/img/about/about-building.webp" type="image/webp" />
              <img src="/assets/img/about/about-building.jpg" alt="Shidike factory building in Dongguan, Guangdong" loading="lazy" decoding="async" />
            </picture>
            <div class="about-card-body">
              <h3>Founded in 2013</h3>
              <p class="about-card-sub">Dongguan, Guangdong</p>
              <p>Shidike has built industrial static eliminators in Dongguan for over a decade. Anti static bars and ionizing air blowers are the core line; web cleaning systems came second.</p>
            </div>
          </article>
          <article class="about-card" data-aos="fade-up" data-aos-delay="80">
            <picture>
              <source srcset="/assets/img/about/about-workshop-3.webp" type="image/webp" />
              <img src="/assets/img/about/about-workshop-3.jpg" alt="Shidike technicians assembling cleaning equipment" loading="lazy" decoding="async" />
            </picture>
            <div class="about-card-body">
              <h3>Engineering In-House</h3>
              <p class="about-card-sub">50 staff, including our own engineers</p>
              <p>Design, assembly and testing happen under one roof. A change to bar length, mounting or control signals goes to the people who build it, not through a trading company.</p>
            </div>
          </article>
          <article class="about-card" data-aos="fade-up" data-aos-delay="160">
            <picture>
              <source srcset="/assets/img/about/about-workshop-1.webp" type="image/webp" />
              <img src="/assets/img/about/about-workshop-1.jpg" alt="Shidike production floor" loading="lazy" decoding="async" />
            </picture>
            <div class="about-card-body">
              <h3>Five Granted Patents</h3>
              <p class="about-card-sub">Cleaning and dust-removal equipment</p>
              <p>Four utility model patents and one design patent, granted in China, covering the cleaning and dust-removal equipment we manufacture.</p>
            </div>
          </article>
          <article class="about-card" data-aos="fade-up" data-aos-delay="240">
            <picture>
              <source srcset="/assets/img/about/about-lobby.webp" type="image/webp" />
              <img src="/assets/img/about/about-lobby.jpg" alt="Shidike company lobby" loading="lazy" decoding="async" />
            </picture>
            <div class="about-card-body">
              <h3>Built to Your Line</h3>
              <p class="about-card-sub">Not sold in fixed sizes</p>
              <p>Anti static bars are cut to the width of your material, up to 3 m. Send the material, line speed, working distance and measured surface voltage, and we return a model and mounting position.</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- Certifications -->
    <section id="certifications" class="page-section bg-light">
      <div class="container">
        <div class="text-center" data-aos="fade-up">
          <h2 class="section-heading text-uppercase">Certifications</h2>
          <p class="section-subheading text-muted">Certified quality and international compliance</p>
        </div>
        <div class="cert-marquee" data-aos="fade-up">
          <div class="cert-track">
            <div class="cert-slide"><picture><source srcset="/assets/img/cert/cert1.webp" type="image/webp" /><img src="/assets/img/cert/cert1.png" alt="ISO 9001:2015 quality management system certificate, English version" loading="lazy" decoding="async" /></picture></div>
            <div class="cert-slide"><picture><source srcset="/assets/img/cert/cert2.webp" type="image/webp" /><img src="/assets/img/cert/cert2.png" alt="CE certificate of conformity, Low Voltage Directive 2014/35/EU, sheet cleaning machine" loading="lazy" decoding="async" /></picture></div>
            <div class="cert-slide"><picture><source srcset="/assets/img/cert/cert3.webp" type="image/webp" /><img src="/assets/img/cert/cert3.png" alt="Computer software copyright registration certificate, PRC National Copyright Administration" loading="lazy" decoding="async" /></picture></div>
            <div class="cert-slide"><picture><source srcset="/assets/img/cert/cert4.webp" type="image/webp" /><img src="/assets/img/cert/cert4.png" alt="ISO 9001:2015 quality management system certificate, Chinese version" loading="lazy" decoding="async" /></picture></div>
            <div class="cert-slide"><picture><source srcset="/assets/img/cert/cert5.webp" type="image/webp" /><img src="/assets/img/cert/cert5.png" alt="Utility model patent certificate, cleaning equipment" loading="lazy" decoding="async" /></picture></div>
            <div class="cert-slide"><picture><source srcset="/assets/img/cert/cert6.webp" type="image/webp" /><img src="/assets/img/cert/cert6.png" alt="Utility model patent certificate, lens adhesive dust-removal machine" loading="lazy" decoding="async" /></picture></div>
            <div class="cert-slide"><picture><source srcset="/assets/img/cert/cert7.webp" type="image/webp" /><img src="/assets/img/cert/cert7.png" alt="Utility model patent certificate, dust-removal machine" loading="lazy" decoding="async" /></picture></div>
            <div class="cert-slide"><picture><source srcset="/assets/img/cert/cert8.webp" type="image/webp" /><img src="/assets/img/cert/cert8.png" alt="Design patent certificate, dust remover test machine" loading="lazy" decoding="async" /></picture></div>
            <div class="cert-slide" aria-hidden="true"><picture><source srcset="/assets/img/cert/cert1.webp" type="image/webp" /><img src="/assets/img/cert/cert1.png" alt="" loading="lazy" decoding="async" /></picture></div>
            <div class="cert-slide" aria-hidden="true"><picture><source srcset="/assets/img/cert/cert2.webp" type="image/webp" /><img src="/assets/img/cert/cert2.png" alt="" loading="lazy" decoding="async" /></picture></div>
            <div class="cert-slide" aria-hidden="true"><picture><source srcset="/assets/img/cert/cert3.webp" type="image/webp" /><img src="/assets/img/cert/cert3.png" alt="" loading="lazy" decoding="async" /></picture></div>
            <div class="cert-slide" aria-hidden="true"><picture><source srcset="/assets/img/cert/cert4.webp" type="image/webp" /><img src="/assets/img/cert/cert4.png" alt="" loading="lazy" decoding="async" /></picture></div>
            <div class="cert-slide" aria-hidden="true"><picture><source srcset="/assets/img/cert/cert5.webp" type="image/webp" /><img src="/assets/img/cert/cert5.png" alt="" loading="lazy" decoding="async" /></picture></div>
            <div class="cert-slide" aria-hidden="true"><picture><source srcset="/assets/img/cert/cert6.webp" type="image/webp" /><img src="/assets/img/cert/cert6.png" alt="" loading="lazy" decoding="async" /></picture></div>
            <div class="cert-slide" aria-hidden="true"><picture><source srcset="/assets/img/cert/cert7.webp" type="image/webp" /><img src="/assets/img/cert/cert7.png" alt="" loading="lazy" decoding="async" /></picture></div>
            <div class="cert-slide" aria-hidden="true"><picture><source srcset="/assets/img/cert/cert8.webp" type="image/webp" /><img src="/assets/img/cert/cert8.png" alt="" loading="lazy" decoding="async" /></picture></div>
          </div>
        </div>
      </div>
    </section>

    <!-- Get a Free Quote -->
    <section class="quote-section" id="contact">
      <div class="quote-overlay"></div>
      <div class="container quote-content">
        <div class="text-center" data-aos="fade-up">
          <h2 class="quote-title">GET A FREE QUOTE</h2>
          <p class="quote-desc">If you are searching for information about our products, please submit your inquiry by filling out the form below.</p>
        </div>
        <form action="https://formspree.io/f/mvzlpdwy" method="POST" class="quote-form" data-aos="fade-up" data-aos-delay="100">
          <input type="text" name="name" placeholder="Your name (Required)" required />
          <input type="email" name="email" placeholder="Your email address (Required)" required />
          <input type="text" name="phone" placeholder="Your phone number" />
          <textarea name="message" rows="5" placeholder="Please enter your message information" required></textarea>
          <button type="submit">Send message</button>
        </form>
      </div>
    </section>

  </main>

  <!-- Footer CTA -->
  <section class="home-bottom-cta">
    <div class="container" data-aos="fade-up">
      <h2>Ready to Start Your Project?</h2>
      <p>Contact Shidike for industrial static eliminators, ionizing bars, and precision cleaning machines for production lines worldwide.</p>
      <a href="/contact" class="home-bottom-btn">Get a Free Quote</a>
    </div>
  </section>

  <style>
    .fix-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; margin-top: 34px; }
    .fix-item { background: #fff; border: 1px solid var(--hairline); padding: 24px 24px 22px; display: flex; flex-direction: column; }
    .fix-item h3 { margin: 0 0 10px; font-size: 1.08rem; font-weight: 700; color: var(--navy); line-height: 1.35; }
    .fix-item p { margin: 0 0 16px; font-size: 14.5px; line-height: 1.6; color: var(--ink-muted); }
    .fix-fix {
      margin-top: auto; padding-top: 14px; border-top: 1px solid #eef2f5;
      font-size: 13px; font-weight: 700; color: var(--brand-deep);
    }
    @media (max-width: 991px) { .fix-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 620px) { .fix-grid { grid-template-columns: 1fr; } }
  </style>
  <style>
    /* Single-row certificate marquee: the track holds two copies of the set and
       slides exactly one copy's width, so the loop point is invisible. */
    .cert-marquee {
      margin-top: 34px;
      overflow: hidden;
      -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
              mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    }
    .cert-track {
      display: flex;
      gap: 22px;
      width: max-content;
      animation: cert-scroll 48s linear infinite;
    }
    .cert-marquee:hover .cert-track { animation-play-state: paused; }
    .cert-slide {
      flex: 0 0 auto;
      background: #fff;
      border: 1px solid var(--hairline);
      padding: 10px;
    }
    .cert-slide img {
      display: block;
      height: 300px;
      width: auto;
      object-fit: contain;
    }
    @keyframes cert-scroll {
      from { transform: translateX(0); }
      to   { transform: translateX(calc(-50% - 11px)); }
    }
    @media (max-width: 767px) { .cert-slide img { height: 210px; } }
    @media (prefers-reduced-motion: reduce) {
      .cert-track { animation: none; }
      .cert-marquee { overflow-x: auto; }
    }
  </style>
  <style>
    .about-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 22px; margin-top: 38px; }
    .about-card { background: #fff; border: 1px solid var(--hairline); display: flex; flex-direction: column; }
    .about-card img { display: block; width: 100%; aspect-ratio: 16 / 10; object-fit: cover; }
    .about-card-body { padding: 22px 22px 24px; }
    .about-card h3 { margin: 0 0 4px; font-size: 1.1rem; font-weight: 700; color: var(--navy); line-height: 1.3; }
    .about-card-sub {
      margin: 0 0 12px; font-size: 12.5px; font-weight: 700;
      letter-spacing: .06em; text-transform: uppercase; color: var(--brand-deep);
    }
    .about-card-body p:last-child { margin: 0; font-size: 14.5px; line-height: 1.62; color: var(--ink-muted); }
    @media (max-width: 991px) { .about-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 560px) { .about-grid { grid-template-columns: 1fr; } }
  </style>
</Layout>
