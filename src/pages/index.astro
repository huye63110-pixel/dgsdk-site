        <span class="hero-value-label">Customers Served</span>
        <p>Trusted by industrial customers worldwide</p>
      </div>
      <div class="hero-value-card" role="listitem">
        <strong class="hero-value-title"><span aria-hidden="true"><span class="hero-stat-number" data-stat-target="10">10</span>+ <span class="hero-value-unit">Countries</span></span><span class="hero-stat-accessible">10+ Countries</span></strong>
        <span class="hero-value-label">Global Reach</span>
        <p>Products supplied across international markets</p>
      </div>
      <div class="hero-value-card" role="listitem">
        <strong class="hero-value-title"><span aria-hidden="true"><span class="hero-stat-number" data-stat-target="20">20</span>+</span><span class="hero-stat-accessible">20+</span></strong>
        <span class="hero-value-label">Patents &amp; IP</span>
        <p>Independent R&amp;D and patented technologies</p>
      </div>
      <div class="hero-value-card" role="listitem">
        <strong class="hero-value-title"><span aria-hidden="true"><span class="hero-stat-number" data-stat-target="100">100</span>%</span><span class="hero-stat-accessible">100%</span></strong>
