<section class="company-section certificate-showcase" id="certifications" aria-labelledby="company-certificates-heading" data-certificate-mode="marquee">
  <div class="container">
      <div class="company-certificate-heading"><h2 id="company-certificates-heading">CERTIFICATIONS</h2><p>Company certificates &amp; registered patents</p></div>
      <div class="company-certificate-grid">
