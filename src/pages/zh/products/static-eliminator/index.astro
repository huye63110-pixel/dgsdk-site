---
import ZhLayout from '../../../../layouts/ZhLayout.astro';

const base = 'https://www.dg-sdk.com';
const canonical = base + '/zh/products/static-eliminator';
const products = [
  { name: 'ST-G 智能静电消除棒', url: canonical + '/st-g-series', image: base + '/assets/img/static-eliminator/st-g.jpg' },
  { name: 'ST-E 智能离子棒', url: canonical + '/st-e-series', image: base + '/assets/img/static-eliminator/st-e.jpg' },
  { name: 'ST-F 智能离子棒', url: canonical + '/st-f-series', image: base + '/assets/img/static-eliminator/st-f.jpg' },
  { name: 'ST-S200 迷你离子风机', url: canonical + '/st-s200', image: base + '/assets/img/static-eliminator/st-s200.jpg' },
  { name: 'ST101A 台式离子鼓风机', url: canonical + '/st-101a', image: base + '/assets/img/static-eliminator/st-101a.jpg' },
  { name: 'ST104A 卧式离子鼓风机', url: canonical + '/st-104a', image: base + '/assets/img/static-eliminator/st-104a.jpg' },
  { name: 'ST1200 卧式离子风机', url: canonical + '/st-1200', image: base + '/assets/img/static-eliminator/st-1200.jpg' },
];
const faqItems = [
  { question: '什么是工业静电消除器？', answer: '工业静电消除器产生平衡的正负离子，用于中和无法直接接地的绝缘材料与生产表面的静电荷。' },
  { question: '什么时候选择离子棒，什么时候选择离子风机？', answer: '宽幅或连续移动的目标，如输送带、薄膜、片材和卷材线，优先选择离子棒；工作台、设备腔体、异形工件或距离较远的目标，通常选择离子风机或鼓风机。' },
  { question: '离子棒选型需要提供哪些资料？', answer: '请提供材料、带电区域宽度、线速度、安装距离、实测电压、安装空间、环境条件以及所需的设备控制信号。' },
  { question: '离子棒如何维护？', answer: '根据现场污染程度定期检查和清洁放电针，确认接地，并使用合适的静电场测试仪或充电板监测仪验证消电效果。' },
];
---

<ZhLayout
  title="工业静电消除器与离子棒 | DGSDK 史帝克"
  description="史帝克面向全球提供工业静电消除器、离子棒、静电消除棒、离子风机和离子鼓风机，适用于电子、薄膜、包装、印刷、塑料、纺织、SMT及显示制造。"
  canonical={canonical}
>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首页', item: base + '/zh/' },
      { '@type': 'ListItem', position: 2, name: '产品', item: base + '/zh/products' },
      { '@type': 'ListItem', position: 3, name: '静电消除器与离子棒', item: canonical }
    ]
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: '工业静电消除器与离子棒',
    url: canonical,
    description: '工业离子棒、静电消除棒、离子风机和离子鼓风机产品集合。',
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: products.length,
      itemListElement: products.map((product, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        item: {
          '@type': 'Product',
          name: product.name,
          url: product.url,
          image: product.image,
          brand: { '@type': 'Brand', name: 'DGSDK 史帝克' }
        }
      }))
    }
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map(item => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: { '@type': 'Answer', text: item.answer }
    }))
  })} />

  <section
    class="products-hero"
    style="background: linear-gradient(rgba(10, 25, 45, 0.46), rgba(10, 25, 45, 0.32)), url('/assets/img/static-eliminator/banner-bg2.webp') center/cover no-repeat; background-attachment: fixed;"
  >
    <div class="container products-hero-inner">
      <span class="products-hero-kicker" data-aos="fade-down" data-aos-duration="600">第一产品线 · 全球供应</span>
      <h1 data-aos="fade-up" data-aos-duration="700" data-aos-delay="100">工业静电消除器与离子棒</h1>
      <p data-aos="fade-up" data-aos-duration="700" data-aos-delay="200">
        静电消除棒用于移动材料和设备集成，离子风机与离子鼓风机用于工作台和设备腔体的静电控制。
      </p>
    </div>
  </section>

  <section class="category-info-block">
    <div class="container" style="max-width:900px;">
      <h2>面向工业产线的离子棒与静电消除棒</h2>
      <p><strong>离子棒</strong>也称静电消除棒、静电棒或静电控制棒，通过产生平衡的正负离子，中和材料表面的静电荷。史帝克将棒式静电消除器作为网站第一且最重要的产品组。</p>
      <p>适用于输送带、片材、薄膜、塑料件、包装材料、印刷基材、PCB、偏光片及其他带电目标。选型需要结合目标宽度、线速度、工作距离、实测静电、安装空间和控制接口。</p>
      <p><a href="/zh/contact">提交应用资料</a>，获取适用于您所在国家或生产现场的型号与安装建议。</p>
    </div>
  </section>

  <section class="products-overview-section">
    <div class="container products-overview-layout">
      <aside class="products-sidebar">
        <div class="products-sidebar-box">
          <h3>产品分类</h3>
          <a href="/zh/products">所有产品</a>
          <a href="/zh/products/static-eliminator" class="active-category">静电消除器与离子棒</a>
          <a href="/zh/products/cleaning-machine">工业清洁机</a>
        </div>
      </aside>

      <div class="products-main">
        <section class="apple-product-section">
          <div class="products-category-header">
            <span class="apple-product-label">棒式 · 核心产品</span>
            <h2>离子棒与静电消除棒</h2>
            <p>适用于宽幅、移动或设备集成目标，在规定宽度内持续中和静电。</p>
          </div>
          <div class="apple-card-grid">
            <a href="/zh/products/static-eliminator/st-g-series" class="apple-product-card">
              <picture><source srcset="/assets/img/static-eliminator/st-g.webp" type="image/webp" /><img src="/assets/img/static-eliminator/st-g.jpg" alt="ST-G 工业静电消除棒与离子棒" loading="lazy" /></picture>
              <span class="apple-card-tag">离子棒</span><h3>ST-G 智能静电消除棒</h3><p>用于生产线静电中和的棒式离子发生器。</p>
            </a>
            <a href="/zh/products/static-eliminator/st-e-series" class="apple-product-card">
              <picture><source srcset="/assets/img/static-eliminator/st-e.webp" type="image/webp" /><img src="/assets/img/static-eliminator/st-e.jpg" alt="ST-E 工业离子棒" loading="lazy" /></picture>
              <span class="apple-card-tag">离子棒</span><h3>ST-E 智能离子棒</h3><p>用于设备集成的紧凑型静电控制棒。</p>
            </a>
            <a href="/zh/products/static-eliminator/st-f-series" class="apple-product-card">
              <picture><source srcset="/assets/img/static-eliminator/st-f.webp" type="image/webp" /><img src="/assets/img/static-eliminator/st-f.jpg" alt="ST-F 快速响应静电消除棒" loading="lazy" /></picture>
              <span class="apple-card-tag">离子棒</span><h3>ST-F 智能离子棒</h3><p>适用于连续生产线的快速响应离子棒。</p>
            </a>
          </div>
        </section>

        <section class="apple-product-section">
          <div class="products-category-header">
            <span class="apple-product-label">送风式</span>
            <h2>离子鼓风机与离子风机</h2>
            <p>适用于工作台、设备腔体和需要离子气流覆盖较远距离的目标。</p>
          </div>
          <div class="apple-card-grid">
            <a href="/zh/products/static-eliminator/st-s200" class="apple-product-card">
              <picture><source srcset="/assets/img/static-eliminator/st-s200.webp" type="image/webp" /><img src="/assets/img/static-eliminator/st-s200.jpg" alt="ST-S200 迷你离子风机" loading="lazy" /></picture>
              <span class="apple-card-tag">离子风机</span><h3>ST-S200 迷你离子风机</h3><p>为敏感工作区域提供紧凑型离子气流覆盖。</p>
            </a>
            <a href="/zh/products/static-eliminator/st-101a" class="apple-product-card">
              <picture><source srcset="/assets/img/static-eliminator/st-101a.webp" type="image/webp" /><img src="/assets/img/static-eliminator/st-101a.jpg" alt="ST101A 台式离子鼓风机" loading="lazy" /></picture>
              <span class="apple-card-tag">离子鼓风机</span><h3>ST101A 台式离子鼓风机</h3><p>用于工作台的定向静电中和气流。</p>
            </a>
            <a href="/zh/products/static-eliminator/st-104a" class="apple-product-card">
              <picture><source srcset="/assets/img/static-eliminator/st-104a.webp" type="image/webp" /><img src="/assets/img/static-eliminator/st-104a.jpg" alt="ST104A 卧式离子鼓风机" loading="lazy" /></picture>
              <span class="apple-card-tag">离子鼓风机</span><h3>ST104A 卧式离子鼓风机</h3><p>适用于更宽覆盖区域的卧式离子送风。</p>
            </a>
            <a href="/zh/products/static-eliminator/st-1200" class="apple-product-card">
              <img src="/assets/img/static-eliminator/st-1200.jpg" alt="ST1200 卧式离子风机" loading="lazy" />
              <span class="apple-card-tag">离子风机</span><h3>ST1200 卧式离子风机</h3><p>适用于工作台和生产线的宽幅静电控制。</p>
            </a>
          </div>
        </section>
      </div>
    </div>
  </section>

  <section class="category-info-block">
    <div class="container" style="max-width:900px;">
      <h2>静电消除器如何工作？</h2>
      <p>静电消除器通过高压使放电针周围空气离子化，正负离子向带相反极性的目标移动，从而降低目标表面的净静电荷。导体可通过接地泄放电荷，而绝缘薄膜、塑料件、涂层表面、PCB材料等无法直接接地的目标需要主动离子化。</p>

      <h2>离子棒还是离子风机？</h2>
      <ul>
        <li><strong>选择离子棒：</strong>宽幅或移动目标、输送线、薄膜、片材、包装、印刷、塑料、纺织以及卷对卷或卷材工艺。</li>
        <li><strong>选择离子风机或鼓风机：</strong>手工作业台、设备腔体、异形工件，或距离超出无辅助气流离子棒有效范围的目标。</li>
      </ul>

      <h2>主要应用行业</h2>
      <ul>
        <li>电子、PCB、SMT及元器件装配</li>
        <li>光学薄膜、偏光片、LCD、OLED及显示制造</li>
        <li>包装、印刷、标签、复合加工及移动卷材线</li>
        <li>塑料、注塑、橡胶及复合材料加工</li>
        <li>纺织、无纺布、电池、光伏及其他自动化产线</li>
      </ul>

      <h2>选型需要提供的信息</h2>
      <p>请提供材料及目标尺寸、实测静电或现场问题、线速度、离子棒到目标的距离、可用安装长度、环境条件、电源以及所需的PLC或报警信号。工程人员据此评估型号、棒长、安装位置和数量。</p>

      <h2>维护与验证</h2>
      <p>放电针污染会降低离子输出并影响平衡。检查和清洁周期应依据实际环境制定。安装后确认接地，并使用合适的静电场测试仪或充电板监测仪验证消电效果。具体操作与电气限制以对应型号资料为准。</p>

      <h2>静电消除器常见问题</h2>
      <div class="faq-list">
        {faqItems.map(item => (
          <article class="faq-item">
            <h3>{item.question}</h3>
            <p>{item.answer}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="related-categories-section">
    <div class="container">
      <h2 class="related-cat-title">第二产品线：工业清洁机</h2>
      <p class="related-cat-desc">完成静电控制后，史帝克工业清洁机用于去除PCB、FPC、光学薄膜、偏光片和显示基材表面的颗粒。</p>
      <div class="related-cat-grid">
        <a href="/zh/products/cleaning-machine" class="related-cat-card">
          <picture><source srcset="/assets/img/cleaning-machine/polarizer-cleaner.webp" type="image/webp" /><img src="/assets/img/cleaning-machine/polarizer-cleaner.jpg" alt="史帝克工业清洁机" loading="lazy" /></picture>
          <div class="related-cat-info">
            <h3>工业清洁机</h3>
            <p>按基材、产线形式和工艺位置比较干式接触清洁设备。</p>
            <span class="related-cat-link">查看产品 →</span>
          </div>
        </a>
        <a href="/zh/guides/what-is-an-ionizing-bar" class="related-cat-card">
          <picture><source srcset="/assets/img/static-eliminator/st-e.webp" type="image/webp" /><img src="/assets/img/static-eliminator/st-e.jpg" alt="工业离子棒指南" loading="lazy" /></picture>
          <div class="related-cat-info">
            <h3>什么是离子棒？</h3>
            <p>了解工作原理、应用场景、安装因素和选型标准。</p>
            <span class="related-cat-link">阅读指南 →</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <style>
    .products-hero h1,
    .products-hero p { color: #fff !important; text-shadow: 0 2px 18px rgba(0, 0, 0, 0.45); }
    .products-category-header { margin-bottom: 24px; }
    .products-category-header h2 { margin: 6px 0 8px; }
    .products-category-header p { margin: 0; color: #5f6368; }
    .faq-list { display: grid; gap: 18px; margin-top: 24px; }
    .faq-item { padding: 20px 22px; border-radius: 16px; background: #fff; }
    .faq-item h3 { margin-top: 0; }
    .faq-item p { margin-bottom: 0; }
  </style>
</ZhLayout>
