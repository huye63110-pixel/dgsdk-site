---
// Guides index, rebuilt to the confirmed resource-page layout.
//
// Title, meta description, canonical and the BreadcrumbList are unchanged from
// what this page already published. The H1 keeps its existing wording for the
// same reason as /blog: the design's short "Guides" would drop the keywords
// this indexed page currently ranks on.
//
// All seven guides are listed. The design reference shows four, one of which
// ("5 Benefits of an Ionizing Bar in Your Workspace") has no page on this site;
// dropping the other three would have orphaned live URLs, so the layout is
// adopted and the list stays complete.
import Layout from '../../layouts/Layout.astro';
import ResourceIndex from '../../components/ResourceIndex.astro';
import ResourceFeature from '../../components/ResourceFeature.astro';
import ResourceGrid from '../../components/ResourceGrid.astro';
import { guides, featuredGuide, categoriesOf } from '../../data/resources.js';

const base = 'https://www.dg-sdk.com';
const canonical = base + '/guides';

const items = guides.map((g) => ({ ...g, excerpt: g.blurb }));
const featured = items.find((g) => g.href === featuredGuide) || items[0];
const rail = items.filter((g) => g !== featured).slice(0, 3);
---

<Layout
  title="ESD & Static Control Guides | Industrial Knowledge Base | Shidike"
  description="ESD and static electricity guides for industrial manufacturing: what is ESD, how to prevent static shock, ESD control products, and industrial static eliminator solutions."
>
  <link slot="head" rel="stylesheet" href="/css/resource-pages.css" />

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: base },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: canonical }
    ]
  })} />

  <ResourceIndex
    eyebrow="Resources · Guides"
    heading="ESD & Static Control Guides"
    lead="Understand the methods behind static control and surface cleaning. Build a foundation for equipment selection and process checks."
    crumb="Guides"
    active="guides"
    cta={{
      heading: 'Need documentation for a specific model?',
      text: 'Tell us the model and your installation requirements. Ask about the product documentation for your application.',
      label: 'Ask About Documentation',
      href: '/contact',
    }}
  >
    <ResourceFeature
      featured={featured}
      rail={rail}
      kicker="Start here · Fundamentals"
      caption="Application illustration from What Is an Ionizing Bar?"
      ctaLabel="Read the guide"
    />

    <ResourceGrid
      eyebrow="Explore by topic"
      heading="All Guides."
      lead="Explore ionization, practical static prevention and web-cleaning methods."
      items={items}
      categories={categoriesOf(items)}
      kind="Guides"
    />
  </ResourceIndex>
</Layout>
