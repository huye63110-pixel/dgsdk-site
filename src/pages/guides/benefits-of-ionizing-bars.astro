  .guide-article h3 { font-size: 19px; line-height: 1.4; color: var(--ink); margin: 26px 0 10px; }
  .guide-article p, .guide-article li { font-size: 16px; line-height: 1.8; }
  .guide-article p { margin: 0 0 16px; }
  .guide-article a { color: var(--blue); text-underline-offset: 3px; }
  .guide-article .guide-button { color: var(--ink); }
  .guide-article .source-note { font-size: 12px; color: var(--muted); line-height: 1.7; margin: 18px 0 0; }
