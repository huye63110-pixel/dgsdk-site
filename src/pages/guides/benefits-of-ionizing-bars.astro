  .ion-guide h1 span { display: block; font-size: .65em; line-height: 1.25; font-weight: 500; letter-spacing: -.6px; margin-top: 12px; }
  .hero-intro { font-size: 17px; line-height: 1.7; color: var(--muted); max-width: 540px; }
  .guide-actions { display: flex; gap: 20px; flex-wrap: wrap; align-items: center; margin-top: 26px; }
  .guide-button { display: inline-flex; justify-content: center; align-items: center; gap: 16px; padding: 14px 20px; border-radius: 6px; background: #f5c400; color: #172231; font-size: 14px; font-weight: 700; text-decoration: none; line-height: 1.45; }
  .guide-button:hover { background: #e4b600; }
  .ion-guide .text-link { color: var(--blue); font-weight: 600; font-size: 14px; text-underline-offset: 4px; }
  .hero-product { margin: 0; border: 1px solid var(--line); background: #fff; border-radius: 12px; overflow: hidden; }
  .hero-product img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: contain; }
  .hero-product figcaption { display: flex; gap: 10px; flex-direction: column; padding: 18px 24px; border-top: 1px solid var(--line); }
  .hero-product figcaption > span { font-size: 10px; letter-spacing: 1.4px; color: var(--muted); }
  .hero-product figcaption a { color: var(--ink); font-size: 14px; font-weight: 600; text-decoration: none; }
  .guide-layout { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 64px; align-items: start; padding-top: 52px; padding-bottom: 80px; }
  .guide-sidebar { position: sticky; top: 130px; }
  .guide-sidebar ol { list-style: none; margin: 0; padding: 0; border-left: 1px solid var(--line); }
  .guide-sidebar li { margin: 0; }
  .guide-sidebar li a { display: block; padding: 10px 0 10px 16px; font-size: 13px; line-height: 1.5; color: var(--muted); text-decoration: none; }
  .guide-sidebar li a:hover { color: var(--blue); background: #f3f6f7; }
  .sidebar-contact { display: block; margin-top: 22px; font-size: 12px; color: var(--blue); font-weight: 600; text-underline-offset: 4px; }
  .guide-article { min-width: 0; }
  .guide-article section { scroll-margin-top: 130px; margin-bottom: 52px; }
