  caption { caption-side: top; padding: 16px; text-align: left; color: var(--muted); font-size: 12px; }
  th, td { padding: 16px; border-top: 1px solid var(--line); vertical-align: top; }
  thead { background: #f0f6f8; }
  tbody th { width: 25%; font-weight: 600; }
  .application-list { list-style: none; padding: 0; margin: 24px 0; }
  .application-list li { padding: 16px 0; border-bottom: 1px solid var(--line); }
  .application-list strong, .application-list span { display: block; }
  .application-list span { color: var(--muted); }
  .selection-list { padding-left: 23px; margin: 24px 0; }
  .selection-list li { padding-left: 8px; margin-bottom: 16px; }
  .model-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; margin: 24px 0; }
  .model-card { display: flex; flex-direction: column; padding: 22px 18px; border: 1px solid var(--line); border-top: 3px solid var(--blue); border-radius: 7px; text-decoration: none; }
  .model-card:hover { background: #f0f6f8; }
  .model-tag { font-size: 9px; letter-spacing: .7px; font-weight: 700; }
  .model-card h3 { display: flex; justify-content: space-between; font-size: 25px; margin: 16px 0 12px; }
  .model-card p { font-size: 14px; color: var(--muted); line-height: 1.7; }
