<style>
  /* Click-to-play video. A bare YouTube iframe pulls roughly a megabyte of
     third-party script on page load and sets cookies before the reader has done
     anything; this ships a poster image instead and only builds the iframe when
     the reader asks for it. */
  .video-embed { margin: 26px 0; }
  .video-embed-trigger {
    position: relative; display: block; width: 100%; padding: 0;
    border: 0; border-radius: 12px; overflow: hidden; cursor: pointer;
    background: #0f1e29; aspect-ratio: 16 / 9; line-height: 0;
  }
  .video-embed-poster { width: 100%; height: 100%; object-fit: cover; display: block; }
  .video-embed-icon {
    position: absolute; inset: 0; display: grid; place-items: center;
    transition: transform .2s ease;
  }
  .video-embed-icon-bg { fill: #212121; fill-opacity: .8; transition: fill-opacity .2s ease; }
  .video-embed-trigger:hover .video-embed-icon-bg,
  .video-embed-trigger:focus-visible .video-embed-icon-bg { fill: #f00; fill-opacity: 1; }
  .video-embed-trigger:focus-visible { outline: 3px solid var(--brand, #03b1ee); outline-offset: 3px; }
  /* :global because this element is created by the script below, so it never
     carries Astro's scoping attribute and a scoped selector would not match it -
     which left the player at the browser default 300x150. */
  .video-embed :global(iframe) {
    width: 100%; aspect-ratio: 16 / 9; height: auto;
    border: 0; border-radius: 12px; display: block;
  }
  .video-embed figcaption {
    margin-top: 10px; font-size: .875rem; line-height: 1.6; color: #6b7784;
  }
  .video-embed figcaption a { color: var(--brand, #03b1ee); }
  @media (prefers-reduced-motion: reduce) {
    .video-embed-icon, .video-embed-icon-bg { transition: none; }
  }
</style>

<script is:inline>
  (function () {
    document.querySelectorAll('.video-embed-poster[data-fallback]').forEach(function (img) {
      // maxresdefault does not exist for every video; hqdefault always does.
      img.addEventListener('error', function handle() {
        img.removeEventListener('error', handle);
        img.src = img.dataset.fallback;
      });
    });

    document.querySelectorAll('.video-embed-trigger').forEach(function (button) {
      button.addEventListener('click', function () {
        var id = button.dataset.youtubeId;
        if (!id) return;
        var frame = document.createElement('iframe');
        // nocookie host, and autoplay because the reader just asked for it.
        frame.src = 'https://www.youtube-nocookie.com/embed/' + id + '?autoplay=1&rel=0';
        frame.title = button.getAttribute('aria-label') || 'Video';
        frame.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
        frame.referrerPolicy = 'strict-origin-when-cross-origin';
        frame.allowFullscreen = true;
        button.replaceWith(frame);
        frame.focus({ preventScroll: true });
      });
    });
  })();
</script>

