---
import Layout from '../../../layouts/Layout.astro';

const base = 'https://www.dg-sdk.com';
const canonical = base + '/products/cleaning-machine';
const sheetProducts = [
  {
    name: 'LCM Module Cleaner', slug: 'lcm-cleaner', cat: 'Sheet & Board', code: 'LCM',
    url: canonical + '/lcm-cleaner', image: base + '/assets/img/cleaning-machine/lcm-cleaner.jpg',
    img: '/assets/img/cleaning-machine/lcm-cleaner',
    specs: ['0.022–0.34 mm', 'Breakage <0.02 %', '0–50 m/min', 'Static <100 V']
  },
  {
    name: 'CCL Cleaning Machine', slug: 'ccl-cleaner', cat: 'Sheet & Board', code: 'ST-DT1340',
    url: canonical + '/ccl-cleaner', image: base + '/assets/img/cleaning-machine/ccl-cleaner.jpg',
    img: '/assets/img/cleaning-machine/ccl-cleaner',
    specs: ['0.05–3 mm', '99.9 % removal', '0–70 m/min', '350 W']
  },
  {
    name: 'SMT Inline Cleaner', slug: 'smt-cleaner', cat: 'Sheet & Board', code: 'SMT600',
    url: canonical + '/smt-cleaner', image: base + '/assets/img/cleaning-machine/smt-cleaner.jpg',
    img: '/assets/img/cleaning-machine/smt-cleaner',
    specs: ['50–600 mm width', 'Static to <30 V', '0–45 m/min', 'By-pass mode']
  },
  {
    name: 'PCB Surface Cleaner', slug: 'pcb-cleaner', cat: 'Sheet & Board', code: 'STXF',
    url: canonical + '/pcb-cleaner', image: base + '/assets/img/cleaning-machine/pcb-cleaner.jpg',
    img: '/assets/img/cleaning-machine/pcb-cleaner',
    specs: ['0.05–2 mm', '99.9 % removal', '0–20 m/min', 'Static <50 V']
  },
  {
    name: 'PCB Vertical Cleaner', slug: 'pcb-vertical-cleaner', cat: 'Sheet & Board', code: 'STC-640',
    url: canonical + '/pcb-vertical-cleaner', image: base + '/assets/img/cleaning-machine/stick-pcb-vertical-cleaning-machine.jpg',
    img: '/assets/img/cleaning-machine/stick-pcb-vertical-cleaning-machine',
    specs: ['W620 × L510 mm max', '0.1–2 mm', '~6 s per board', 'Static <50 V']
  },
  {
    name: 'FPC 4-Axis Cleaner', slug: 'fpc-4-axis-cleaner', cat: 'Sheet & Board', code: 'STXT',
    url: canonical + '/fpc-4-axis-cleaner', image: base + '/assets/img/cleaning-machine/fpc-4-axis-cleaner.jpg',
    img: '/assets/img/cleaning-machine/fpc-4-axis-cleaner',
    specs: ['0.022–0.34 mm', '4 tacky rollers', '0–50 m/min', 'Static <200 V']
  },
  {
    name: 'FPC 8-Axis Cleaner', slug: 'fpc-8-axis-cleaner', cat: 'Sheet & Board', code: 'STXS',
    url: canonical + '/fpc-8-axis-cleaner', image: base + '/assets/img/cleaning-machine/fpc-8-axis-cleaner.jpg',
    img: '/assets/img/cleaning-machine/fpc-8-axis-cleaner',
    specs: ['0.028–2 mm', '8 tacky rollers', '0–35 m/min', 'Static <200 V']
  },
  {
    name: 'Stamp Inspection Cleaner', slug: 'inspection-cleaner', cat: 'Sheet & Board', code: 'ST-XT',
    url: canonical + '/inspection-cleaner', image: base + '/assets/img/cleaning-machine/inspection-cleaner.jpg',
    img: '/assets/img/cleaning-machine/inspection-cleaner',
    specs: ['0.05–0.65 mm', '2 MP colour CCD', '0–50 m/min', 'Backlight 20 000 LUX']
  },
  {
    name: 'Polarizer Precision Cleaner', slug: 'polarizer-cleaner', cat: 'Sheet & Board', code: null,
    note: 'Model code to confirm',
    url: canonical + '/polarizer-cleaner', image: base + '/assets/img/cleaning-machine/polarizer-cleaner.jpg',
    img: '/assets/img/cleaning-machine/polarizer-cleaner'
  },
  {
    name: 'Backlight Panel Cleaner', slug: 'backlight-cleaner', cat: 'Sheet & Board', code: null,
    note: 'Model code to confirm',
    url: canonical + '/backlight-cleaner', image: base + '/assets/img/cleaning-machine/backlight-cleaner.jpg',
    img: '/assets/img/cleaning-machine/backlight-cleaner'
  },
];
const webProducts = [
  {
    name: 'Large-Size Optical Film Cleaner', slug: 'optical-film-cleaner', cat: 'Roll-to-Roll', code: 'STFK',
    url: canonical + '/optical-film-cleaner', image: base + '/assets/img/cleaning-machine/optical.jpg',
    img: '/assets/img/cleaning-machine/optical',
    specs: ['0.065–0.68 mm', '99.9 % removal', '0–40 m/min', 'Static <100 V']
  },
  {
    name: 'Roll-to-Roll Cleaner', slug: 'roll-chip-cleaner', cat: 'Roll-to-Roll', code: 'Coil Universal',
    url: canonical + '/roll-chip-cleaner', image: base + '/assets/img/cleaning-machine/roll-chip-cleaner.jpg',
    img: '/assets/img/cleaning-machine/roll-chip-cleaner',
    specs: ['0.05–2 mm', 'Surface static <50 V', '0–20 m/min', 'Unwind + rewind']
  },
];
const allCleaningProducts = [...sheetProducts, ...webProducts];
const faqItems = [
  {
    question: 'How does contact cleaning actually work?',
    answer: 'An elastomer roller runs against the surface and lifts loose particles off it. Those particles transfer onto an adhesive paper roll, which winds them away permanently rather than redistributing them. That is the difference from an air knife or a brush: both move contamination around, and a contact cleaner removes it from the line.'
  },
  {
    question: 'Which belt will my material need?',
    answer: 'Three belt types are available. An elastic belt is the standard and is what almost every machine ships with — we use Nitta and Forbo Siegling belts. A roller belt and a round belt are also available, but they are specified only occasionally, for materials the standard belt does not suit. The belt is chosen from your sample: thickness, and whether the back face can take contact, are usually what decide it.'
  },

  {
    question: 'How is the cleaning roller chosen?',
    answer: 'Three roller materials are available: liquid silicone, solid silicone and rubber. Which one you need is decided from your sample, and it is the most important choice on the machine. Too little tack and fine particles stay on your material; too much and the roller pulls at the surface, which on thin film or a soft coating causes its own defects. We match the material and the grade to the sample you send rather than picking one from a datasheet.'
  },

  {
    question: 'What are the consumables and how often do they change?',
    answer: 'Two per machine: the elastomer cleaning roller, and the adhesive paper roll that takes particles off it. The paper is supplied as two rolls — one upper, one lower — with a 3.0 inch core, 20 m per roll, 800 D tack and knife-free changeover. Rollers and rolls pull out on a drawer mechanism, so a change does not mean dismantling the machine.'
  },
  {
    question: 'What material thickness and width can be cleaned?',
    answer: 'Thickness from 0.022 mm up to 6 mm depending on configuration, effective width to 1500 mm, and length unrestricted on continuous material. The roller gap is adjustable from 0.1 to 6.0 mm with a one-touch mechanism and a digital readout, so one machine covers a range of thicknesses rather than a single one.'
  },
  {
    question: 'Do I need static control as well as cleaning?',
    answer: 'Yes, on almost every application. A charged surface pulls particles back out of the air within seconds of leaving the machine, so cleaning without neutralizing solves half the problem. The standard build is two ST-G ionizing bars made to the width of the machine. The ST-E is specified on wide machines where balance has to hold across the full span, and the ST-F where line speed is high. Some machines are also built with ST104A blowers mounted low on both sides.',
    answerHtml: 'Yes, on almost every application. A charged surface pulls particles back out of the air within seconds of leaving the machine, so cleaning without neutralizing solves half the problem. The standard build is two <a href="/products/static-eliminator/st-g-series">ST-G ionizing bars</a> made to the width of the machine. The <a href="/products/static-eliminator/st-e-series">ST-E</a> is specified on wide machines where balance has to hold across the full span, and the <a href="/products/static-eliminator/st-f-series">ST-F</a> where line speed is high. Some machines are also built with <a href="/products/static-eliminator/st-104a">ST104A blowers</a> mounted low on both sides.'
  },
  {
    question: 'What is the difference between contact and non-contact?',
    answer: 'Contact cleaning runs an elastomer roller against the surface — it takes off what is stuck, not just what is loose, and it is what most board and sheet applications use. Non-contact refers to the transport: a magnetic levitation drive moves the material without mechanical contact on the working face, used where the surface cannot take roller pressure at all, such as ultra-thin film or coated optical layers.'
  }
];
---

<Layout title="Web Cleaning Systems for PCB, FPC and Film | Shidike"
  description="Contact cleaning machines and web cleaning systems built to your sample. Belt, roller tack, roller gap and the static package are chosen from your material — 0.022 to 6 mm thick, to 1500 mm wide.">

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: base },
      { '@type': 'ListItem', position: 2, name: 'Web Cleaning Systems', item: canonical }
    ]
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Web Cleaning Systems for PCB, FPC and Film',
    url: canonical,
    description: 'Contact cleaning machines and web cleaning systems for PCB, FPC, CCL, polarizer, backlight, optical film and roll-to-roll production, built to the customer sample.',
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: allCleaningProducts.length,
      itemListElement: allCleaningProducts.map((product, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: product.name,
        url: product.url,
        image: product.image
      }))
    }
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map(item => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: { '@type': 'Answer', text: item.answer }
    }))
  })} />
  <section
    class="products-hero"
    style="background: linear-gradient(rgba(255, 255, 255, 0.28), rgba(255, 255, 255, 0.18)), url('/assets/img/cleaning-machine/web-cleaning-line.jpg') center/cover no-repeat; background-attachment: fixed; background-image: linear-gradient(rgba(255, 255, 255, 0.28), rgba(255, 255, 255, 0.18)), image-set(url('/assets/img/cleaning-machine/web-cleaning-line.webp') type('image/webp'), url('/assets/img/cleaning-machine/web-cleaning-line.jpg') type('image/jpeg'));"
  >
    <div class="container products-hero-inner">
      <span class="products-hero-kicker" data-aos="fade-down" data-aos-duration="600">Second Product Line</span>
      <h1 data-aos="fade-up" data-aos-duration="700" data-aos-delay="100">Web Cleaning Systems for PCB, FPC and Film</h1>
      <p data-aos="fade-up" data-aos-duration="700" data-aos-delay="200">
        Professional industrial cleaning solutions for PCB, FPC, polarizer,
        backlight, optical film, SMT, LCM, and other precision manufacturing applications.
      </p>
    </div>
  </section>

  <section class="products-overview-section">
    <div class="container products-overview-layout">
      <div class="finder">
        <div class="finder-lead"><span>Two ways to clean<br />a surface:</span></div>
        <div class="finder-opts">
          <a class="finder-opt" href="/products/cleaning-machine/contact-cleaning-machine">
            <svg viewBox="0 0 48 48" aria-hidden="true"><rect x="6" y="18" width="36" height="12" rx="2"/><path d="M12 30v5M36 30v5M6 24h36"/></svg>
            <span class="finder-opt-title">Contact &mdash; adhesive roller</span>
            <span class="finder-opt-sub">Most board, sheet and film work</span>
          </a>
          <a class="finder-opt" href="/products/cleaning-machine/non-contact-cleaning-machine">
            <svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="12" cy="24" r="8"/><circle cx="36" cy="24" r="8"/><path d="M12 16h24M12 32h24"/></svg>
            <span class="finder-opt-title">Non-contact &mdash; brush and vacuum</span>
            <span class="finder-opt-sub">Surfaces that cannot take tack</span>
          </a>
        </div>
      </div>

      <aside class="products-sidebar">
        <div class="products-sidebar-box">
          <h2>Browse Categories</h2>
          <a href="/products/static-eliminator">Static Eliminators &amp; Ionizing Bars</a>
          <a href="/products/cleaning-machine" class="active-category">Industrial Cleaning Machines</a>
        </div>
      </aside>

      <div class="products-main">
        <section class="pl-group" id="types">
          <div class="pl-group-head">
            <h2>Start Here: Contact or Non-Contact</h2>
            <p>Every machine we build is one of these two, configured to your material. There is no standard model to order from &mdash; width, belt, roller, gap and single or double sided are all set from your sample.</p>
          </div>
          <div class="pcard-grid">
            <a href="/products/cleaning-machine/contact-cleaning-machine" class="pcard">
              <picture class="pcard-media">
                <source srcset="/assets/img/cleaning-machine/ccl-cleaner.webp" type="image/webp" />
                <img src="/assets/img/cleaning-machine/ccl-cleaner.jpg" alt="Contact cleaning machine with adhesive rollers" loading="lazy" />
              </picture>
              <div class="pcard-body">
                <span class="pcard-cat">Adhesive roller</span>
                <h3>Contact Cleaning Machine</h3>
                <p class="pcard-name">An elastomer roller lifts particles off the surface onto an adhesive paper roll. What most board, sheet and film work uses.</p>
                <ul class="pcard-specs">
                  <li>50&ndash;1340 mm, built to material</li>
                  <li>0.05&ndash;3 mm thickness</li>
                  <li>Up to 70 m/min &middot; 99.9 % removal</li>
                  <li>3 belt types &middot; 3 roller materials</li>
                </ul>
                <span class="pcard-cta"><span class="pcard-arrow">&rarr;</span>View product</span>
              </div>
            </a>
            <a href="/products/cleaning-machine/non-contact-cleaning-machine" class="pcard">
              <picture class="pcard-media">
                <source srcset="/assets/img/cleaning-machine/vacuum-brush-cleaner.webp" type="image/webp" />
                <img src="/assets/img/cleaning-machine/vacuum-brush-cleaner.jpg" alt="Non-contact vacuum brush cleaning machine with dust collector" loading="lazy" />
              </picture>
              <div class="pcard-body">
                <span class="pcard-cat">Brush and vacuum</span>
                <h3>Non-Contact Cleaning Machine</h3>
                <p class="pcard-name">Fibre brushes free the particles and a 2200 m&sup3;/h vacuum carries them away. Nothing tacky touches the working face.</p>
                <ul class="pcard-specs">
                  <li>750 mm cleaning width</li>
                  <li>Static held under 100 V</li>
                  <li>0&ndash;45 m/min &middot; 99.9 % removal</li>
                  <li>Separate Toray-cartridge collector</li>
                </ul>
                <span class="pcard-cta"><span class="pcard-arrow">&rarr;</span>View product</span>
              </div>
            </a>
          </div>
        </section>

        <p class="pl-count">Configurations we have built &mdash; {allCleaningProducts.length} machines</p>

        <section class="pl-group" id="sheet">
          <div class="pl-group-head">
            <h2>Built for Sheet &amp; Board</h2>
            <p>Contact machines we have built for discrete boards and sheets. Each is the same process configured differently &mdash; belt, roller gap and roller tack set from the sample.</p>
          </div>
          <div class="pcard-grid">
            {sheetProducts.map(item => (
              <a href={`/products/cleaning-machine/${item.slug}`} class="pcard">
                <picture class="pcard-media">
                  <source srcset={`${item.img}.webp`} type="image/webp" />
                  <img src={`${item.img}.jpg`} alt={`Shidike ${item.name}${item.code && item.code !== item.name ? `, model ${item.code}` : ''} — industrial contact cleaning machine`} loading="lazy" />
                </picture>
                <div class="pcard-body">
                  <span class="pcard-cat">{item.cat}</span>
                  <h3>{item.code || item.name}</h3>
                  <p class="pcard-name">{item.code ? item.name : item.note}</p>
                  {item.specs && <ul class="pcard-specs">{item.specs.map(v => <li>{v}</li>)}</ul>}
                  <span class="pcard-cta"><span class="pcard-arrow">&rarr;</span>View product</span>
                </div>
              </a>
            ))}
          </div>
        </section>

        <section class="pl-group" id="web">
          <div class="pl-group-head">
            <h2>Built for Roll-to-Roll &amp; Film</h2>
            <p>Contact machines we have built for continuous material off a roll, cleaned in line between unwind and rewind.</p>
          </div>
          <div class="pcard-grid">
            {webProducts.map(item => (
              <a href={`/products/cleaning-machine/${item.slug}`} class="pcard">
                <picture class="pcard-media">
                  <source srcset={`${item.img}.webp`} type="image/webp" />
                  <img src={`${item.img}.jpg`} alt={`Shidike ${item.name}${item.code && item.code !== item.name ? `, model ${item.code}` : ''} — industrial contact cleaning machine`} loading="lazy" />
                </picture>
                <div class="pcard-body">
                  <span class="pcard-cat">{item.cat}</span>
                  <h3>{item.code || item.name}</h3>
                  <p class="pcard-name">{item.code ? item.name : item.note}</p>
                  {item.specs && <ul class="pcard-specs">{item.specs.map(v => <li>{v}</li>)}</ul>}
                  <span class="pcard-cta"><span class="pcard-arrow">&rarr;</span>View product</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      </div>
    </div>
  </section>

  <section class="config-section">
    <div class="container">
      <h2>How a machine is configured</h2>
      <p class="config-intro">
        Every machine is built to the sample you send. Two choices do most of the work &mdash;
        what carries your material through, and what lifts the particles off it.
      </p>
      <div class="config-grid">
        <div class="config-card">
          <h3>Transport belt</h3>
          <ul>
            <li><strong>Elastic belt</strong> &mdash; the standard, and what almost every machine
              ships with. We use <strong>Nitta</strong> and <strong>Forbo Siegling</strong> belts.</li>
            <li><strong>Roller belt</strong> &mdash; specified occasionally.</li>
            <li><strong>Round belt</strong> &mdash; specified occasionally.</li>
          </ul>
          <p class="config-note">Thickness, and whether the back face can take contact, usually decide it.</p>
        </div>
        <div class="config-card">
          <h3>Cleaning roller</h3>
          <ul>
            <li><strong>Liquid silicone</strong></li>
            <li><strong>Solid silicone</strong></li>
            <li><strong>Rubber</strong></li>
          </ul>
          <p class="config-note">Graded by tack. Too little and fine particles stay on the material;
            too much and the roller pulls at the surface. Matched to your sample, not to a datasheet.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="related-categories-section">
    <div class="container">
      <h2 class="related-cat-title">Next: Static Eliminators &amp; Ionizing Bars</h2>
      <p class="related-cat-desc">Cleaning a charged surface does not hold — the charge pulls particles back out of the air within seconds. Most machines ship with two ST-G bars fitted.</p>
      <div class="related-cat-grid">
        <a href="/products/static-eliminator" class="related-cat-card">
          <picture><source srcset="/assets/img/static-eliminator/st-g.webp" type="image/webp" /><img src="/assets/img/static-eliminator/st-g.jpg" alt="Shidike anti static bars and ionizing air blowers" loading="lazy" /></picture>
          <h3>Anti Static Bars &amp; Ionizing Air Blowers</h3>
          <span>View the range &rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <section class="faq-tail">
    <div class="container">
      <h2>What to send for a machine recommendation</h2>
      <p>
        There is no catalogue model that fits a line. Every machine is <strong>built to the sample
        you send us</strong> — the belt, the roller tack, the gap and the static package are all
        chosen from your material. Send these and we will specify all four:
      </p>
      <ul class="send-list">
        <li>A sample of your material, and its thickness</li>
        <li>Working width, and whether length is fixed or continuous</li>
        <li>Line speed</li>
        <li>Conveyor height you need to match on the upstream and downstream equipment</li>
        <li>Whether the back face can take contact, or must stay unmarked</li>
      </ul>
      <p><a class="send-cta" href="/contact">Send your sample details &rarr;</a></p>

      <h2>Common questions</h2>
      <div class="faq-list">
        {faqItems.map(item => (
          <details class="faq-item">
            <summary><h3 class="faq-question">{item.question}</h3></summary>
            <p class="faq-answer" set:html={item.answerHtml || item.answer} />
          </details>
        ))}
      </div>
    </div>
  </section>


  <style>
    .config-section { padding: 56px 0; }
    .config-section .container { max-width: 900px; }
    .config-section h2 { text-align: center; font-size: 1.85rem; letter-spacing: -0.015em; margin: 0 0 8px; }
    .config-intro { text-align: center; color: var(--ink-muted); max-width: 62ch; margin: 0 auto 30px; }
    .config-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    .config-card { border: 1px solid var(--hairline); border-radius: 10px; padding: 24px; background: #fff; }
    .config-card h3 { margin: 0 0 14px; font-size: 1.1rem; }
    .config-card ul { margin: 0 0 14px; padding-left: 20px; }
    .config-card li { margin-bottom: 8px; line-height: 1.6; }
    .config-note { margin: 0; font-size: 14px; color: var(--ink-muted); line-height: 1.65; }
    @media (max-width: 720px) { .config-grid { grid-template-columns: 1fr; } }

    .products-hero h1,
    .products-hero p { color: #fff !important; text-shadow: 0 2px 18px rgba(0, 0, 0, 0.45); }
    .products-category-header { margin-bottom: 24px; }
    .products-category-header h2 { margin: 6px 0 8px; }
    .products-category-header p { margin: 0; color: #5f6368; }
    /* The lower half was grey -> white -> grey with three different container
       widths. Make it one continuous surface on a single left edge. */
    /* "Next" block: same surface, no seam, and no rounded floating cards */
    .related-categories-section { padding: 64px 0 !important; background: #f7f8fa !important; }
    .related-cat-title { margin-bottom: 6px; }
    .related-cat-grid { grid-template-columns: repeat(2, 1fr) !important; gap: 20px !important; max-width: 900px; }
    .related-cat-card {
      border-radius: 0 !important;
      box-shadow: none !important;
      border: 1px solid var(--hairline) !important;
      background: #fff !important;
      transition: border-color .15s ease !important;
    }
    .related-cat-card:hover { transform: none !important; border-color: var(--brand-deep) !important; }
    .related-cat-info h3 { font-size: 1.05rem; }
    .related-cat-link { color: var(--brand-deep); font-weight: 700; }

    /* Sidebar: flatten the rounded floating card so it reads as one block
       with the product list beside it, sharing the same top rule. */
    .products-sidebar-box {
      background: transparent !important;
      border: 0 !important;
      border-top: 1px solid var(--hairline) !important;
      border-radius: 0 !important;
      box-shadow: none !important;
      padding: 12px 0 0 !important;
    }
    .products-sidebar-box h2 {
      font-size: 12.5px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
      color: #7d8d97; margin: 0 0 10px;
    }
    .products-sidebar-box a {
      display: block; padding: 9px 0; font-size: 15px; color: #3d4f5c;
      text-decoration: none; border-bottom: 1px solid var(--hairline);
    }
    .products-sidebar-box a:hover { color: var(--brand-deep); }
    .products-sidebar-box a.active-category {
      background: transparent !important; color: var(--navy) !important; font-weight: 700;
      box-shadow: inset 3px 0 0 var(--brand); padding-left: 12px;
    }

    /* The theme applies `section { padding: 9rem 0 }` to every <section>, which put
       144px of dead space above and below each product group. Reset it here. */
    .pl-group { padding: 0 !important; scroll-margin-top: 110px; }

    /* ---------- finder: spans the same two columns as the sidebar + grid below,
       so the navy block and "Browse Categories" share one left edge ---------- */
    .finder {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: subgrid;
      margin-bottom: 34px;
    }
