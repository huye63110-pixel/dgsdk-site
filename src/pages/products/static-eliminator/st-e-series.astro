              <picture><source srcset="/assets/img/static-eliminator/st-g.webp" type="image/webp" /><img src="/assets/img/static-eliminator/st-g.jpg" alt="Shidike ST-G pulsed AC ionizing bar, ion balance plus or minus 50 V" loading="lazy" /></picture>
              <h4>ST-G Series Intelligent Ion Rod</h4>
            </a>
            <a href="/products/static-eliminator/st-e-series" class="related-slide-card" data-key="st-e-series">
              <picture><source srcset="/assets/img/static-eliminator/st-e.webp" type="image/webp" /><img src="/assets/img/static-eliminator/st-e.jpg" alt="Shidike ST-E high-frequency pulsed DC ionizing bar for wide-span static control" loading="lazy" /></picture>
              <h4>ST-E Series Intelligent Ion Rod</h4>
            </a>
            <a href="/products/static-eliminator/st-f-series" class="related-slide-card" data-key="st-f-series">
              <picture><source srcset="/assets/img/static-eliminator/st-f.webp" type="image/webp" /><img src="/assets/img/static-eliminator/st-f.jpg" alt="Shidike ST-F pulsed DC ionizing bar" loading="lazy" /></picture>
              <h4>ST-F Series Intelligent Ion Rod</h4>
            </a>
            <a href="/products/static-eliminator/st-s200" class="related-slide-card" data-key="st-s200">
              <picture><source srcset="/assets/img/static-eliminator/st-s200.webp" type="image/webp" /><img src="/assets/img/static-eliminator/st-s200.jpg" alt="Shidike ST-S200 mini ionizing air blower, 450 by 450 mm coverage" loading="lazy" /></picture>
              <h4>ST-S200 Mini Ionizer Fan</h4>
            </a>
            <a href="/products/static-eliminator/st-101a" class="related-slide-card" data-key="st-101a">
              <picture><source srcset="/assets/img/static-eliminator/st-101a.webp" type="image/webp" /><img src="/assets/img/static-eliminator/st-101a.jpg" alt="Shidike ST101A desktop ionizing air blower, 40 by 60 cm coverage" loading="lazy" /></picture>
              <h4>ST101A Table Ionizing Air Blower</h4>
            </a>
            <a href="/products/static-eliminator/st-104a" class="related-slide-card" data-key="st-104a">
              <picture><source srcset="/assets/img/static-eliminator/st-104a.webp" type="image/webp" /><img src="/assets/img/static-eliminator/st-104a.jpg" alt="Shidike ST104A horizontal ionizing air blower, 60 by 120 cm coverage" loading="lazy" /></picture>
              <h4>ST104A Horizontal Ion Blower</h4>
            </a>
            <a href="/products/static-eliminator/st-1200" class="related-slide-card" data-key="st-1200">
              <img src="/assets/img/static-eliminator/st-1200.jpg" alt="Shidike ST1200 wide-area ionizing air blower, 1280 mm covering 140 by 120 cm" loading="lazy" />
              <h4>ST1200 Horizontal Ion Fan</h4>
            </a>
          </div>
        </div>
      </section>
    </div>
  </section>

