---
import Layout from '../../../layouts/Layout.astro';

const base = 'https://www.dg-sdk.com';
const canonical = base + '/products/static-eliminator';
const barProducts = [
  { name: 'ST-G Intelligent Static Elimination Bar', url: canonical + '/st-g-series', image: base + '/assets/img/static-eliminator/st-g.jpg' },
  { name: 'ST-E Intelligent Ionizing Bar', url: canonical + '/st-e-series', image: base + '/assets/img/static-eliminator/st-e.jpg' },
  { name: 'ST-F Intelligent Ionizing Bar', url: canonical + '/st-f-series', image: base + '/assets/img/static-eliminator/st-f.jpg' },
];
const blowerProducts = [
  { name: 'ST-S200 Mini Ionizer Fan', url: canonical + '/st-s200', image: base + '/assets/img/static-eliminator/st-s200.jpg' },
  { name: 'ST101A Desktop Ionizing Air Blower', url: canonical + '/st-101a', image: base + '/assets/img/static-eliminator/st-101a.jpg' },
  { name: 'ST104A Horizontal Ion Blower', url: canonical + '/st-104a', image: base + '/assets/img/static-eliminator/st-104a.jpg' },
  { name: 'ST1200 Horizontal Ion Fan', url: canonical + '/st-1200', image: base + '/assets/img/static-eliminator/st-1200.jpg' },
];
const allStaticProducts = [...barProducts, ...blowerProducts];
const faqItems = [
  {
    question: 'What is an industrial static eliminator?',
    answer: 'An industrial static eliminator generates balanced positive and negative ions that neutralize electrostatic charge on insulating materials and production surfaces that cannot be grounded directly.'
  },
  {
    question: 'When should I use an ionizing bar instead of an ion blower?',
    answer: 'Use an ionizing bar for wide or continuously moving targets such as conveyors, films, sheets, and web lines. Use an ion blower or fan when ionized airflow must reach a workstation, enclosure, or target positioned farther away.'
  },
  {
    question: 'What information is needed to select an ionizing bar?',
    answer: 'Provide the material, charged area width, line speed, installation distance, measured voltage, available mounting space, environment, and required machine-control signals.'
  },
  {
    question: 'How are ionizing bars maintained?',
    answer: 'Inspect and clean emitter points at intervals based on the contamination level, confirm grounding, and verify neutralization performance with a suitable static field meter or charged plate monitor.'
  }
];
---

<Layout
  title="Industrial Static Eliminators & Ionizing Bars | DGSDK"
  description="DGSDK industrial static eliminators and ionizing bars for worldwide electronics, film, packaging, printing, plastics, textile, SMT, and display production lines."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: base },
      { '@type': 'ListItem', position: 2, name: 'Products', item: base + '/products' },
      { '@type': 'ListItem', position: 3, name: 'Static Eliminators and Ionizing Bars', item: canonical }
    ]
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Industrial Static Eliminators and Ionizing Bars',
    url: canonical,
    description: 'Industrial ionizing bars, static eliminator bars, ionizer fans, and ionizing blowers for electrostatic control on production lines worldwide.',
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: allStaticProducts.length,
      itemListElement: allStaticProducts.map((product, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        item: {
          '@type': 'Product',
          name: product.name,
          url: product.url,
          image: product.image,
          brand: { '@type': 'Brand', name: 'DGSDK' }
        }
      }))
    }
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map(item => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: { '@type': 'Answer', text: item.answer }
    }))
  })} />

  <section
    class="products-hero"
    style="background: linear-gradient(rgba(10, 25, 45, 0.46), rgba(10, 25, 45, 0.32)), url('/assets/img/static-eliminator/banner-bg2.webp') center/cover no-repeat; background-attachment: fixed;"
  >
    <div class="container products-hero-inner">
      <span class="products-hero-kicker" data-aos="fade-down" data-aos-duration="600">Primary Product Line · Worldwide Supply</span>
      <h1 data-aos="fade-up" data-aos-duration="700" data-aos-delay="100">Industrial Static Eliminators &amp; Ionizing Bars</h1>
      <p data-aos="fade-up" data-aos-duration="700" data-aos-delay="200">
        Bar-type static eliminators for moving materials and machine integration, plus ionizing blowers and fans for workstations and enclosed process areas.
      </p>
    </div>
  </section>

  <section class="category-info-block">
    <div class="container" style="max-width:900px;">
      <h2>Ionizing bars for industrial static control</h2>
      <p><strong>An ionizing bar</strong>—also called an ionizer bar, static eliminator bar, anti-static bar, static control bar, or, in British English, an ionising bar—neutralizes electrostatic charge on material surfaces by delivering balanced positive and negative ions. DGSDK's bar-type static eliminators are the first and most important product group on this website.</p>
      <p>Use these products above conveyors, sheets, films, plastic parts, packaging materials, printing substrates, PCB panels, polarizers, and other charged targets. The correct model depends on target width, line speed, working distance, measured charge, installation space, and required control interface.</p>
      <p><a href="/contact">Send your application details</a> to receive a model and installation recommendation for your country or production site.</p>
    </div>
  </section>

  <section class="products-overview-section">
    <div class="container products-overview-layout">
      <aside class="products-sidebar">
        <div class="products-sidebar-box">
          <h3>Browse Categories</h3>
          <a href="/products">All Products</a>
          <a href="/products/static-eliminator" class="active-category">Static Eliminators &amp; Ionizing Bars</a>
          <a href="/products/cleaning-machine">Industrial Cleaning Machines</a>
        </div>
      </aside>

      <div class="products-main">
        <section class="apple-product-section">
          <div class="products-category-header">
            <div>
              <span class="apple-product-label">Bar Type · Primary Focus</span>
              <h2>Ionizing Bars &amp; Static Eliminator Bars</h2>
              <p>For wide, moving, or machine-integrated targets where static must be neutralized across a defined span.</p>
            </div>
          </div>
          <div class="apple-card-grid">
            <a href="/products/static-eliminator/st-g-series" class="apple-product-card" data-aos="fade-up" data-aos-delay="0" data-aos-duration="600">
              <picture><source srcset="/assets/img/static-eliminator/st-g.webp" type="image/webp" /><img src="/assets/img/static-eliminator/st-g.jpg" alt="ST-G industrial static eliminator and ionizing bar" loading="lazy" /></picture>
              <span class="apple-card-tag">Ionizing Bar</span>
              <h3>ST-G Intelligent Static Elimination Bar</h3>
              <p>Bar-type ionizer for production-line static neutralization.</p>
            </a>
            <a href="/products/static-eliminator/st-e-series" class="apple-product-card" data-aos="fade-up" data-aos-delay="80" data-aos-duration="600">
              <picture><source srcset="/assets/img/static-eliminator/st-e.webp" type="image/webp" /><img src="/assets/img/static-eliminator/st-e.jpg" alt="ST-E industrial ionizing bar" loading="lazy" /></picture>
              <span class="apple-card-tag">Ionizing Bar</span>
              <h3>ST-E Intelligent Ionizing Bar</h3>
              <p>Compact static control bar for machine integration.</p>
            </a>
            <a href="/products/static-eliminator/st-f-series" class="apple-product-card" data-aos="fade-up" data-aos-delay="160" data-aos-duration="600">
              <picture><source srcset="/assets/img/static-eliminator/st-f.webp" type="image/webp" /><img src="/assets/img/static-eliminator/st-f.jpg" alt="ST-F fast-response static eliminator bar" loading="lazy" /></picture>
              <span class="apple-card-tag">Ionizing Bar</span>
              <h3>ST-F Intelligent Ionizing Bar</h3>
              <p>Fast-response ionizing bar for continuous lines.</p>
            </a>
          </div>
        </section>

        <section class="apple-product-section">
          <div class="products-category-header">
            <div>
              <span class="apple-product-label">Airflow Type</span>
              <h2>Ionizing Air Blowers &amp; Ionizer Fans</h2>
              <p>For workstations, enclosures, and targets that need ionized airflow over a longer working distance.</p>
            </div>
          </div>
          <div class="apple-card-grid">
            <a href="/products/static-eliminator/st-s200" class="apple-product-card" data-aos="fade-up" data-aos-delay="0" data-aos-duration="600">
              <picture><source srcset="/assets/img/static-eliminator/st-s200.webp" type="image/webp" /><img src="/assets/img/static-eliminator/st-s200.jpg" alt="ST-S200 mini ionizer fan" loading="lazy" /></picture>
              <span class="apple-card-tag">Ionizer Fan</span>
              <h3>ST-S200 Mini Ionizer Fan</h3>
              <p>Compact ionized-air coverage for sensitive work areas.</p>
            </a>
            <a href="/products/static-eliminator/st-101a" class="apple-product-card" data-aos="fade-up" data-aos-delay="70" data-aos-duration="600">
              <picture><source srcset="/assets/img/static-eliminator/st-101a.webp" type="image/webp" /><img src="/assets/img/static-eliminator/st-101a.jpg" alt="ST101A desktop ionizing air blower" loading="lazy" /></picture>
              <span class="apple-card-tag">Ionizing Blower</span>
              <h3>ST101A Desktop Ionizing Air Blower</h3>
              <p>Directed static-neutralizing airflow for workstations.</p>
            </a>
            <a href="/products/static-eliminator/st-104a" class="apple-product-card" data-aos="fade-up" data-aos-delay="140" data-aos-duration="600">
              <picture><source srcset="/assets/img/static-eliminator/st-104a.webp" type="image/webp" /><img src="/assets/img/static-eliminator/st-104a.jpg" alt="ST104A horizontal ionizing blower" loading="lazy" /></picture>
              <span class="apple-card-tag">Ionizing Blower</span>
              <h3>ST104A Horizontal Ion Blower</h3>
              <p>Horizontal ionized airflow for wider coverage zones.</p>
            </a>
            <a href="/products/static-eliminator/st-1200" class="apple-product-card" data-aos="fade-up" data-aos-delay="210" data-aos-duration="600">
              <img src="/assets/img/static-eliminator/st-1200.jpg" alt="ST1200 horizontal ionizer fan" loading="lazy" />
              <span class="apple-card-tag">Ionizer Fan</span>
              <h3>ST1200 Horizontal Ion Fan</h3>
              <p>Wide-area static control for workstations and lines.</p>
            </a>
          </div>
        </section>
      </div>
    </div>
  </section>

  <section class="category-info-block">
    <div class="container" style="max-width:900px;">
      <h2>How does a static eliminator work?</h2>
      <p>A static eliminator applies high voltage to emitter points to ionize nearby air. Positive and negative ions move toward the oppositely charged target and reduce its net electrostatic charge. Grounding can drain charge from conductors, but active ionization is used for insulating films, plastic parts, coated surfaces, PCB materials, and other targets that cannot be grounded directly.</p>

      <h2>Ionizing bar or ion blower?</h2>
      <ul>
        <li><strong>Choose an ionizing bar</strong> for wide or moving targets, conveyor lines, films, sheets, packaging, printing, plastics, textiles, and roll-to-roll or web processes.</li>
        <li><strong>Choose an ionizing blower or fan</strong> for manual workstations, enclosed machines, irregular parts, or targets beyond the effective reach of a bar without assisted airflow.</li>
      </ul>

      <h2>Application sectors</h2>
      <ul>
        <li>Electronics, PCB, SMT, and component assembly</li>
        <li>Optical film, polarizer, LCD, OLED, and display manufacturing</li>
        <li>Packaging, printing, labeling, converting, and moving web lines</li>
        <li>Plastics, injection molding, rubber, and composite processing</li>
        <li>Textile, nonwoven, battery, photovoltaic, and other automated lines</li>
      </ul>

      <h2>Information to provide for product selection</h2>
      <p>For an application recommendation, provide the material and target dimensions, measured charge or observed problem, line speed, ionizer-to-target distance, available mounting length, ambient conditions, power supply, and required PLC or alarm signals. This allows the model, bar length, mounting position, and number of units to be reviewed against the real process.</p>

      <h2>Maintenance and verification</h2>
      <p>Emitter contamination reduces ion output and can affect balance. Inspection and cleaning intervals should be based on the actual environment. Confirm grounding after installation and verify neutralization performance with an appropriate static field meter or charged plate monitor. Product-specific procedures and electrical limits should follow the model documentation.</p>

      <h2>Static Eliminator FAQ</h2>
      <div class="faq-list">
        {faqItems.map(item => (
          <article class="faq-item">
            <h3>{item.question}</h3>
            <p>{item.answer}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="related-categories-section">
    <div class="container">
      <h2 class="related-cat-title">Next: Industrial Cleaning Machines</h2>
      <p class="related-cat-desc">After static control, DGSDK's second product line removes particles from PCB, FPC, optical film, polarizer, and display substrates.</p>
      <div class="related-cat-grid">
        <a href="/products/cleaning-machine" class="related-cat-card">
          <picture><source srcset="/assets/img/cleaning-machine/polarizer-cleaner.webp" type="image/webp" /><img src="/assets/img/cleaning-machine/polarizer-cleaner.jpg" alt="DGSDK industrial cleaning machines" loading="lazy" /></picture>
          <div class="related-cat-info">
            <h3>Industrial Cleaning Machines</h3>
            <p>Compare dry-contact cleaners by substrate, line format, and process position.</p>
            <span class="related-cat-link">View Products →</span>
          </div>
        </a>
        <a href="/guides/what-is-an-ionizing-bar" class="related-cat-card">
          <picture><source srcset="/assets/img/static-eliminator/st-e.webp" type="image/webp" /><img src="/assets/img/static-eliminator/st-e.jpg" alt="Guide to industrial ionizing bars" loading="lazy" /></picture>
          <div class="related-cat-info">
            <h3>What Is an Ionizing Bar?</h3>
            <p>Learn operating principles, use cases, installation factors, and selection criteria.</p>
            <span class="related-cat-link">Read Guide →</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <style>
    .products-hero h1,
    .products-hero p { color: #fff !important; text-shadow: 0 2px 18px rgba(0, 0, 0, 0.45); }
    .products-category-header { margin-bottom: 24px; }
    .products-category-header h2 { margin: 6px 0 8px; }
    .products-category-header p { margin: 0; color: #5f6368; }
    .faq-list { display: grid; gap: 18px; margin-top: 24px; }
    .faq-item { padding: 20px 22px; border-radius: 16px; background: #fff; }
    .faq-item h3 { margin-top: 0; }
    .faq-item p { margin-bottom: 0; }
  </style>
</Layout>
