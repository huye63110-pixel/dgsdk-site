---
import Layout from '../../../layouts/Layout.astro';

const base = 'https://www.dg-sdk.com';
const canonical = base + '/products/static-eliminator';
const barProducts = [
  {
    name: 'ST-G Intelligent Ionizing Bar', slug: 'st-g-series', cat: 'Ionizing Bars', code: 'ST-G',
    url: canonical + '/st-g-series', image: base + '/assets/img/static-eliminator/st-g.jpg',
    img: '/assets/img/static-eliminator/st-g',
    desc: 'The all-round bar, and the best ion balance in the range at ±50 V. Pulsed AC applies alternating positive and negative high voltage to a single emitter pin, which produces more ions than conventional AC and avoids the uneven neutralization AC bars are known for. Pulse frequency is adjustable, so the same bar handles a fast-moving web or a still workspace. 6.5 kV DC pulse from a DC 24 V supply, 12 W.',
    specs: ['Ion balance ±50 V', '6.5 kV DC pulse', '30–1000 mm', 'DC 24 V · 12 W']
  },
  {
    name: 'ST-E Intelligent Ionizing Bar', slug: 'st-e-series', cat: 'Ionizing Bars', code: 'ST-E',
    url: canonical + '/st-e-series', image: base + '/assets/img/static-eliminator/st-e.jpg',
    img: '/assets/img/static-eliminator/st-e',
    desc: 'High-frequency pulsed DC with fixed-polarity emitter pins arranged alternately along the bar. Ion generation is raised by 150 % over a conventional bar, which is what lets it hold balance across a wide or long span — the situation where ordinary bars drift. Built for large-area, high-speed lines. Ion balance ±80 V, 6.5 kV DC pulse, 12 W.',
    specs: ['Ion balance ±80 V', '6.5 kV DC pulse', '30–1000 mm', '+150 % ion output']
  },
  {
    name: 'ST-F Intelligent Ionizing Bar', slug: 'st-f-series', cat: 'Ionizing Bars', code: 'ST-F',
    url: canonical + '/st-f-series', image: base + '/assets/img/static-eliminator/st-f.jpg',
    img: '/assets/img/static-eliminator/st-f',
    desc: 'The speed model. Pulsed DC with the Hibweer L.C.C. system, which stops generating negative ions while it makes positive ones and vice versa — giving very strong balance control and neutralizing 2.5 times faster than a conventional bar. Choose it when the material moves too fast for a standard bar to keep up. Ion balance ±100 V, 6.5 kV DC pulse.',
    specs: ['2.5× faster neutralizing', 'Ion balance ±100 V', '6.5 kV DC pulse', '30–1000 mm']
  },
];
const blowerProducts = [
  {
    name: 'ST-S200 Mini Ionizer Fan', slug: 'st-s200', cat: 'Ionizing Blowers', code: 'ST-S200',
    url: canonical + '/st-s200', image: base + '/assets/img/static-eliminator/st-s200.jpg',
    img: '/assets/img/static-eliminator/st-s200',
    desc: 'The smallest unit in the range, small enough to build into a machine. Synchronous positive and negative emitters at ±5000 V with tungsten-alloy tips and a decoupled discharge barrel. Clears a 450 × 450 mm area in under 1.5 s measured 150 mm in front of the outlet, at under 38.9 dB and 0.05 ppm ozone. 128 × 53.5 × 180 mm, 400 g, CE marked, one-year warranty.',
    specs: ['450 × 450 mm coverage', '≤1.5 s decay', '≤48.2 CFM', 'CE · 1-year warranty']
  },
  {
    name: 'ST101A Desktop Ionizing Air Blower', slug: 'st-101a', cat: 'Ionizing Blowers', code: 'ST101A',
    url: canonical + '/st-101a', image: base + '/assets/img/static-eliminator/st-101a.jpg',
    img: '/assets/img/static-eliminator/st-101a',
    desc: 'A desktop blower for one operator position or inspection table. Airflow is adjustable from 45 to 110 CFM over a 40 × 60 cm area, with ion balance held at 0 V ±10 V. At 3.3 kg and 90 × 170 × 260 mm it sits beside a microscope or rework station without taking the bench.',
    specs: ['45–110 CFM', 'Ion balance 0 V ±10 V', '40 × 60 cm', '3.3 kg']
  },
  {
    name: 'ST104A Horizontal Ion Blower', slug: 'st-104a', cat: 'Ionizing Blowers', code: 'ST104A',
    url: canonical + '/st-104a', image: base + '/assets/img/static-eliminator/st-104a.jpg',
    img: '/assets/img/static-eliminator/st-104a',
    desc: 'The ST104A pushes air horizontally across a 60 × 120 cm zone at 70 to 120 CFM, roughly double the coverage of the desktop unit, with ion balance held at 0 V ±10 V. Suited to a two-operator bench, a packing station, or the open side of a conveyor.',
    specs: ['70–120 CFM', 'Ion balance 0 V ±10 V', '60 × 120 cm', '5.8 kg']
  },
  {
    name: 'ST1200 Horizontal Ion Fan', slug: 'st-1200', cat: 'Ionizing Blowers', code: 'ST1200',
    url: canonical + '/st-1200', image: base + '/assets/img/static-eliminator/st-1200.jpg',
    img: '/assets/img/static-eliminator/st-1200',
    desc: 'The widest coverage in the range: 140 × 120 cm at 150 to 360 CFM. At 1280 mm long the ST1200 spans a full line rather than a single station and draws 40 to 80 W. Ion balance is held at 0 V ±10 V.',
    specs: ['150–360 CFM', 'Ion balance 0 V ±10 V', '140 × 120 cm', '40–80 W']
  },
];
const allStaticProducts = [...barProducts, ...blowerProducts];
const faqItems = [
  {
    question: 'What is an anti static bar?',
    answer: 'An anti static bar — also called an ionizing bar, ionizer bar, static eliminator bar, static control bar, or ionising bar in British English — removes static electricity from material surfaces by delivering balanced positive and negative ions. Grounding drains static charges from conductors; an anti static bar is what you use on insulators such as plastic film, polarizer sheets, PCB laminate, packaging webs, and moulded parts that cannot be grounded directly.'
  },
  {
    question: 'How does a static eliminator work?',
    answer: 'A static eliminator applies high voltage to a row of emitter points, ionizing the surrounding air by corona discharge. Positive and negative ions drift toward the oppositely charged surface until its voltage falls toward zero. The process is self-limiting: once the surface reaches neutral, ion uptake stops. Shidike bars run a 6.5 kV DC pulse at 12 W and hold ion balance at ±50 V on the ST-G, the tightest in the range.'
  },
  {
    question: 'What is an industrial static eliminator?',
    answer: 'An industrial static eliminator generates balanced positive and negative ions that neutralize electrostatic charge on insulating materials and production surfaces that cannot be grounded directly.'
  },
  {
    question: 'When should I use an ionizing bar instead of an ion blower?',
    answer: 'Use an ionizing bar for wide or continuously moving targets such as conveyors, films, sheets, and web lines. Use an ion blower or fan when ionized airflow must reach a workstation, enclosure, or target positioned farther away.'
  },
  {
    question: 'What information is needed to select an ionizing bar?',
    answer: 'Provide the material, charged area width, line speed, installation distance, measured voltage, available mounting space, environment, and required machine-control signals.'
  },
  {
    question: 'How are ionizing bars maintained?',
    answer: 'Inspect and clean emitter points at intervals based on the contamination level, confirm grounding, and verify neutralization performance with a suitable static field meter or charged plate monitor.'
  },
  {
    question: 'What is the difference between an anti static bar and an ionizing bar?',
    answer: 'There is no difference. Anti static bar, ionizing bar, ionizer bar, static eliminator bar, and static control bar all describe the same device. Regional and industry habit decides which term is used.'
  },
  {
    question: 'What voltage does an anti static bar output?',
    answer: 'Shidike bars run on a 6.5 kV DC pulse from a DC 24 V supply at 12 W. Ion balance is ±50 V on the ST-G, ±80 V on the ST-E and ±100 V on the ST-F — all inside the sub-100 V window optical and semiconductor work needs.'
  },
  {
    question: 'How close should an anti static bar be mounted to the material?',
    answer: 'Anywhere from 30 mm to 1000 mm — the same working range on all three bar series. Closer mounting speeds up neutralization; the 1 m upper limit is what lets one bar cover a gantry or an overhead position where a closer mount is impossible.'
  },
  {
    question: 'Can an anti static bar be used in a cleanroom?',
    answer: 'Yes. Bar-type static eliminators are used in display, optical film, semiconductor, and PCB cleanrooms. Confirm the required cleanliness class and the mounting method before selecting a model.'
  },
  {
    question: 'Does static control equipment need compressed air?',
    answer: 'The ST-G, ST-E and ST-F bars operate without compressed air. Air-assisted models are available where the target sits beyond the 1 m working range.'
  },
  {
    question: 'Which industries use anti static bars and ionizing air blowers?',
    answer: 'Electronics, PCB and SMT assembly; optical film, polarizer, LCD, OLED and display manufacturing; packaging, printing, labelling and converting lines; plastics, injection moulding and rubber processing; and textile, nonwoven, lithium battery and photovoltaic production. Any process handling an insulating material at speed will build a charge that has to be neutralized.'
  },
  {
    question: 'Do anti static bars prevent electrostatic discharge damage?',
    answer: 'Yes. Uncontrolled electrostatic discharge damages components on SMT and PCB assembly lines, and electrostatic attraction pulls dust back onto surfaces that have just been cleaned. Neutralizing the surface charge removes the cause of both. Verify the result with a static field meter or charged plate monitor rather than assuming it.'
  },
  {
    question: 'What is the difference between an anti static blower and an ionizing bar?',
    answer: 'An anti static blower carries ions to the target on moving air, so it reaches farther and suits workstations, enclosed machines, and irregular parts. An ionizing bar mounts close to the material and neutralizes across a fixed span, which suits conveyors, films, sheets, and web lines.'
  },
  {
    question: 'How much area does an ionizing air blower cover?',
    answer: 'Shidike anti static blowers range from 45 to 360 CFM. The ST101A covers 40 by 60 cm at a workstation, the ST104A covers 60 by 120 cm, and the ST1200 covers 140 by 120 cm for wide lines. The ST-S200 mini ionizer reaches 150 to 450 mm.'
  }
];

---

<Layout
  title="Industrial Static Eliminators, Ionizing Bars & Air Blowers | Shidike"
  image="/assets/img/static-eliminator/st-g.jpg"
  description="Shidike anti static bars and ionizing air blowers. 6.5 kV DC pulse, ion balance from ±50 V, 30–1000 mm working range, made to length up to 3 m."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: base },
      { '@type': 'ListItem', position: 2, name: 'Anti Static Bars and Ionizing Air Blowers', item: canonical }
    ]
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Industrial Static Eliminators and Ionizing Bars',
    url: canonical,
    description: 'Industrial ionizing bars, static eliminator bars, ionizer fans, and ionizing blowers for electrostatic control on production lines worldwide.',
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: allStaticProducts.length,
      itemListElement: allStaticProducts.map((product, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        item: {
          '@type': 'Product',
          name: product.name,
          url: product.url,
          image: product.image,
          brand: { '@type': 'Brand', name: 'Shidike' }
        }
      }))
    }
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map(item => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: { '@type': 'Answer', text: item.answer }
    }))
  })} />

  <section
    class="products-hero static-products-hero"
    style="background: #edf4fb url('/assets/img/static-eliminator/static-eliminator-category-banner.webp') center/86% auto no-repeat; background-attachment: scroll;"
  >
    <div class="container products-hero-inner">
      <span class="products-hero-kicker" data-aos="fade-down" data-aos-duration="600">Primary Product Line · Worldwide Supply</span>
      <h1 data-aos="fade-up" data-aos-duration="700" data-aos-delay="100">Industrial Static Eliminators, Ionizing Bars and Air Blowers</h1>
      <p data-aos="fade-up" data-aos-duration="700" data-aos-delay="200">
        Bar-type static eliminators on a 6.5 kV DC pulse, ion balance from ±50 V over a 30–1000 mm working range, built to the length your line needs, plus ionizing air blowers for workstations and enclosed process areas.
      </p>
    </div>
  </section>

  <section class="products-overview-section">
    <div class="container products-overview-layout">
      <div class="finder">
        <div class="finder-lead"><span>Help me find a<br />static eliminator for:</span></div>
        <div class="finder-opts">
          <a class="finder-opt" href="#bars">
            <svg viewBox="0 0 48 48" aria-hidden="true"><rect x="6" y="20" width="36" height="8" rx="1"/><path d="M12 28v6M20 28v6M28 28v6M36 28v6"/><path d="M4 40h40"/></svg>
            <span class="finder-opt-title">A moving web, film or conveyor</span>
            <span class="finder-opt-sub">Ionizing Bars &amp; Static Eliminator Bars</span>
          </a>
          <a class="finder-opt" href="#blowers">
            <svg viewBox="0 0 48 48" aria-hidden="true"><rect x="10" y="12" width="28" height="20" rx="2"/><path d="M16 36v4M32 36v4M24 36v6"/><path d="M18 20h12M18 25h8"/></svg>
            <span class="finder-opt-title">A workstation, bench or enclosure</span>
            <span class="finder-opt-sub">Ionizing Air Blowers &amp; Anti Static Blowers</span>
          </a>
        </div>
      </div>

      <aside class="products-sidebar">
        <div class="products-sidebar-box">
          <h3>Browse Categories</h3>
          <a href="/products/static-eliminator" class="active-category">Static Eliminators &amp; Ionizing Bars</a>
          <a href="/products/cleaning-machine">Industrial Cleaning Machines</a>
          <a href="/static-eliminator-manufacturer">About the Manufacturer</a>
        </div>
      </aside>

      <div class="products-main">
        <p class="pl-count">Showing all {allStaticProducts.length} products</p>

        <section class="pl-group" id="bars">
          <div class="pl-group-head">
            <h2>Ionizing Bars &amp; Static Eliminator Bars</h2>
            <p>Mounted close to the material, neutralizing across a defined span. For conveyors, films, sheets, and web lines.</p>
          </div>
          <div class="pcard-grid">
            {barProducts.map(item => (
              <a href={`/products/static-eliminator/${item.slug}`} class="pcard">
                <picture class="pcard-media">
                  <source srcset={`${item.img}.webp`} type="image/webp" />
                  <img src={`${item.img}.jpg`} alt={item.name} loading="lazy" />
                </picture>
                <div class="pcard-body">
                  <span class="pcard-cat">{item.cat}</span>
                  <h3>{item.code}</h3>
                  <p class="pcard-name">{item.name}</p>
                  <ul class="pcard-specs">{item.specs.map(v => <li>{v}</li>)}</ul>
                  <span class="pcard-cta"><span class="pcard-arrow">&rarr;</span>View product</span>
                </div>
              </a>
            ))}
          </div>
        </section>

        <section class="pl-group" id="blowers">
          <div class="pl-group-head">
            <h2>Ionizing Air Blowers &amp; Anti Static Blowers</h2>
            <p>Ions carried to the target on moving air, reaching farther than a bar. For workstations, enclosures, and irregular parts.</p>
          </div>
          <div class="pcard-grid">
            {blowerProducts.map(item => (
              <a href={`/products/static-eliminator/${item.slug}`} class="pcard">
                <picture class="pcard-media">
                  <source srcset={`${item.img}.webp`} type="image/webp" />
                  <img src={`${item.img}.jpg`} alt={item.name} loading="lazy" />
                </picture>
                <div class="pcard-body">
                  <span class="pcard-cat">{item.cat}</span>
                  <h3>{item.code}</h3>
                  <p class="pcard-name">{item.name}</p>
                  <ul class="pcard-specs">{item.specs.map(v => <li>{v}</li>)}</ul>
                  <span class="pcard-cta"><span class="pcard-arrow">&rarr;</span>View product</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      </div>
    </div>
  </section>

  <section class="related-categories-section">
    <div class="container">
      <h2 class="related-cat-title">Next: Industrial Cleaning Machines</h2>
      <p class="related-cat-desc">After static control, Shidike's second product line removes particles from PCB, FPC, optical film, polarizer, and display substrates.</p>
      <div class="related-cat-grid">
        <a href="/products/cleaning-machine" class="related-cat-card">
          <picture><source srcset="/assets/img/cleaning-machine/polarizer-cleaner.webp" type="image/webp" /><img src="/assets/img/cleaning-machine/polarizer-cleaner.jpg" alt="Shidike industrial cleaning machines" loading="lazy" /></picture>
          <div class="related-cat-info">
            <h3>Industrial Cleaning Machines</h3>
            <p>Compare dry-contact cleaners by substrate, line format, and process position.</p>
            <span class="related-cat-link">View Products →</span>
          </div>
        </a>
        <a href="/guides/what-is-an-ionizing-bar" class="related-cat-card">
          <picture><source srcset="/assets/img/static-eliminator/st-e.webp" type="image/webp" /><img src="/assets/img/static-eliminator/st-e.jpg" alt="Guide to industrial ionizing bars" loading="lazy" /></picture>
          <div class="related-cat-info">
            <h3>What Is an Ionizing Bar?</h3>
            <p>Learn operating principles, use cases, installation factors, and selection criteria.</p>
            <span class="related-cat-link">Read Guide →</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <section class="faq-tail">
    <div class="container">
      <h2>What to send for a model recommendation</h2>
      <p>Bar length is made to order, so a recommendation needs the real process. Send these and Shidike will return a model, bar length, mounting position, and unit count:</p>
      <ul class="send-list">
        <li>Material and target width</li>
        <li>Line speed</li>
        <li>Measured surface voltage, or the problem you are seeing</li>
        <li>Ionizer-to-target distance and available mounting space</li>
        <li>Required PLC, alarm, or machine-control signals</li>
      </ul>
      <p><a class="send-cta" href="/contact">Send your application details →</a></p>

      <h2>Common questions</h2>
      <div class="faq-list">
        {faqItems.map(item => (
          <details class="faq-item">
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <style>
    .products-hero.static-products-hero::before { content: none !important; background: none !important; }
    .products-hero h1,
    .products-hero p { color: #fff !important; text-shadow: 0 2px 18px rgba(0, 0, 0, 0.45); }
    .products-category-header { margin-bottom: 24px; }
    .products-category-header h2 { margin: 6px 0 8px; }
    .products-category-header p { margin: 0; color: #5f6368; }
    /* The lower half was grey -> white -> grey with three different container
       widths. Make it one continuous surface on a single left edge. */
    /* "Next" block: same surface, no seam, and no rounded floating cards */
    .related-categories-section { padding: 64px 0 !important; background: #f7f8fa !important; }
    .related-cat-title { margin-bottom: 6px; }
    .related-cat-grid { grid-template-columns: repeat(2, 1fr) !important; gap: 20px !important; max-width: 900px; }
    .related-cat-card {
      border-radius: 0 !important;
      box-shadow: none !important;
      border: 1px solid var(--hairline) !important;
      background: #fff !important;
      transition: border-color .15s ease !important;
    }
    .related-cat-card:hover { transform: none !important; border-color: var(--brand-deep) !important; }
    .related-cat-info h3 { font-size: 1.05rem; }
    .related-cat-link { color: var(--brand-deep); font-weight: 700; }

    /* Sidebar: flatten the rounded floating card so it reads as one block
       with the product list beside it, sharing the same top rule. */
    .products-sidebar-box {
      background: transparent !important;
      border: 0 !important;
      border-top: 1px solid var(--hairline) !important;
      border-radius: 0 !important;
      box-shadow: none !important;
      padding: 12px 0 0 !important;
    }
    .products-sidebar-box h3 {
      font-size: 12.5px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
      color: #7d8d97; margin: 0 0 10px;
    }
    .products-sidebar-box a {
      display: block; padding: 9px 0; font-size: 15px; color: #3d4f5c;
      text-decoration: none; border-bottom: 1px solid var(--hairline);
    }
    .products-sidebar-box a:hover { color: var(--brand-deep); }
    .products-sidebar-box a.active-category {
      background: transparent !important; color: var(--navy) !important; font-weight: 700;
      box-shadow: inset 3px 0 0 var(--brand); padding-left: 12px;
    }

    /* The theme applies `section { padding: 9rem 0 }` to every <section>, which put
       144px of dead space above and below each product group. Reset it here. */
    .pl-group { padding: 0 !important; scroll-margin-top: 110px; }

    /* ---------- finder: spans the same two columns as the sidebar + grid below,
       so the navy block and "Browse Categories" share one left edge ---------- */
    .finder {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: subgrid;
      margin-bottom: 34px;
    }
    @supports not (grid-template-columns: subgrid) {
      .finder { grid-template-columns: 280px minmax(0, 1fr); gap: 34px; }
    }
    .finder-lead {
      background: var(--navy); color: #fff; display: flex; align-items: center;
      padding: 30px 26px; font-size: 1.32rem; font-weight: 700; line-height: 1.25;
      letter-spacing: -0.01em;
    }
    .finder-opts { display: grid; grid-template-columns: 1fr 1fr; border: 1px solid var(--hairline); background: #fff; }
    .finder-opt {
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      gap: 9px; padding: 26px 24px; text-align: center; text-decoration: none; color: inherit;
      transition: background .18s ease;
    }
    .finder-opt + .finder-opt { border-left: 1px solid var(--hairline); }
    .finder-opt:hover { background: #f6fafd; }
    .finder-opt svg {
      width: 38px; height: 38px; fill: none; stroke: var(--brand-deep); stroke-width: 2;
      stroke-linecap: round; stroke-linejoin: round;
    }
    .finder-opt-title { font-size: 1.1rem; font-weight: 600; color: var(--navy); letter-spacing: -0.01em; }
    .finder-opt-sub { font-size: 12.5px; font-weight: 700; color: #6b7b88; }

    /* ---------- product card grid ---------- */
    .products-overview-layout { row-gap: 0 !important; }
    .pl-count { font-size: 13.5px; color: #6b7b88; text-align: right; margin: 0 0 6px; }
    .pl-group { padding: 0 !important; scroll-margin-top: 110px; }
    .pl-group + .pl-group { margin-top: 56px; }
    .pl-group-head { padding-bottom: 16px; border-bottom: 1px solid var(--hairline); }
    .pl-group-head h2 { margin: 0 0 8px; font-size: 1.85rem; letter-spacing: -0.015em; }
    .pl-group-head p { margin: 0; font-size: 16px; color: var(--ink-muted); max-width: 66ch; }

    .pcard-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; margin-top: 26px; }
    .pcard {
      display: flex; flex-direction: column; background: #fff; border: 1px solid var(--hairline);
      text-decoration: none; color: inherit;
      transition: border-color .18s ease, box-shadow .18s ease, transform .18s ease;
    }
    .pcard:hover {
      border-color: var(--brand-deep);
      box-shadow: 0 10px 26px rgba(11, 34, 57, .10);
      transform: translateY(-3px);
    }
    .pcard-media { display: block; padding: 26px; background: #fff; border-bottom: 1px solid #eef2f5; }
    .pcard-media img { width: 100%; height: 168px; object-fit: contain; display: block; transition: transform .25s ease; }
    .pcard:hover .pcard-media img { transform: scale(1.04); }
    .pcard-body { display: flex; flex-direction: column; flex: 1; padding: 20px 22px 22px; }
    .pcard-cat {
      font-size: 11.5px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
      color: #8a97a2; margin-bottom: 8px;
    }
    .pcard-body h3 { margin: 0 0 4px; font-size: 1.3rem; font-weight: 700; color: var(--navy); letter-spacing: -0.01em; }
    .pcard-name { margin: 0 0 14px; font-size: 14.5px; color: var(--ink-muted); line-height: 1.5; }
    .pcard-specs { list-style: none; margin: 0 0 18px; padding: 0; display: flex; flex-direction: column; gap: 5px; }
    .pcard-specs li {
      font-size: 13px; font-weight: 600; color: #33495e; font-variant-numeric: tabular-nums;
      padding-left: 14px; position: relative;
    }
