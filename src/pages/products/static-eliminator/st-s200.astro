            <tr><td>Operating temperature</td><td>0–50 °C</td></tr>
            <tr><td>Operating humidity</td><td>30–70 % RH</td></tr>
            <tr><td>Dimensions</td><td>128 × 53.5 × 180 mm (L × W × H)</td></tr>
            <tr><td>Housing</td><td>Flame-retardant plastic</td></tr>
            <tr><td>Mounting hardware</td><td>One stainless U-bracket, one pair of M5 × 10 plastic thumb screws</td></tr>
