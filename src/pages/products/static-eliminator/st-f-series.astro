              <picture><source srcset="/assets/img/static-eliminator/st-g.webp" type="image/webp" /><img src="/assets/img/static-eliminator/st-g.jpg" alt="ST-G Series" loading="lazy" /></picture>
              <h4>ST-G Series Intelligent Ion Rod</h4>
            </a>
            <a href="/products/static-eliminator/st-e-series" class="related-slide-card" data-key="st-e-series">
              <picture><source srcset="/assets/img/static-eliminator/st-e.webp" type="image/webp" /><img src="/assets/img/static-eliminator/st-e.jpg" alt="ST-E Series" loading="lazy" /></picture>
              <h4>ST-E Series Intelligent Ion Rod</h4>
            </a>
            <a href="/products/static-eliminator/st-f-series" class="related-slide-card" data-key="st-f-series">
              <picture><source srcset="/assets/img/static-eliminator/st-f.webp" type="image/webp" /><img src="/assets/img/static-eliminator/st-f.jpg" alt="ST-F Series" loading="lazy" /></picture>
              <h4>ST-F Series Intelligent Ion Rod</h4>
            </a>
            <a href="/products/static-eliminator/st-s200" class="related-slide-card" data-key="st-s200">
              <picture><source srcset="/assets/img/static-eliminator/st-s200.webp" type="image/webp" /><img src="/assets/img/static-eliminator/st-s200.jpg" alt="ST-S200" loading="lazy" /></picture>
              <h4>ST-S200 Mini Ionizer Fan</h4>
            </a>
            <a href="/products/static-eliminator/st-101a" class="related-slide-card" data-key="st-101a">
              <picture><source srcset="/assets/img/static-eliminator/st-101a.webp" type="image/webp" /><img src="/assets/img/static-eliminator/st-101a.jpg" alt="ST101A" loading="lazy" /></picture>
              <h4>ST101A Table Ionizing Air Blower</h4>
            </a>
            <a href="/products/static-eliminator/st-104a" class="related-slide-card" data-key="st-104a">
              <picture><source srcset="/assets/img/static-eliminator/st-104a.webp" type="image/webp" /><img src="/assets/img/static-eliminator/st-104a.jpg" alt="ST104A" loading="lazy" /></picture>
              <h4>ST104A Horizontal Ion Blower</h4>
            </a>
            <a href="/products/static-eliminator/st-1200" class="related-slide-card" data-key="st-1200">
              <img src="/assets/img/static-eliminator/st-1200.jpg" alt="ST1200" loading="lazy" />
              <h4>ST1200 Horizontal Ion Fan</h4>
            </a>
          </div>
        </div>
      </section>
    </div>
  </section>

