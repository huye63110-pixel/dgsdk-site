---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About Shidike | China Static Eliminator & Cleaning Machine Manufacturer" description="About Shidike, a China manufacturer focused on industrial static eliminators and ionizing bars, followed by precision cleaning machines for global production lines.">
  <section
    class="about-hero"
    style="background: linear-gradient(rgba(2, 1, 1, 0.35), rgba(10, 20, 40, 0.25)), url('/assets/img/about/about-building.webp') center/cover no-repeat;">
    <div class="about-hero-overlay"></div>
    <div class="container about-hero-content">
      <span class="about-hero-kicker" data-aos="fade-down" data-aos-duration="600">About Shidike</span>
      <h1 data-aos="fade-up" data-aos-duration="700" data-aos-delay="100">Industrial static control and surface cleaning solutions built for global production.</h1>
      <p>
        Dongguan Shidike Intelligent Equipment Co., Ltd. focuses on industrial static eliminators and ionizing bars first, followed by precision cleaning machines for customers worldwide.
      </p>
    </div>
  </section>

  <section class="about-intro-section">
    <div class="container">
      <div class="about-intro-grid">
        <div class="about-intro-copy" data-aos="fade-right" data-aos-duration="700">
          <span class="about-section-label">Who We Are</span>
          <h2>A professional manufacturer focused on quality, engineering, and practical industrial solutions.</h2>
          <p>
            Shidike is based in Dongguan, China, and is committed to providing reliable products and customized
            solutions for customers in electronics, SMT, display manufacturing, film processing, packaging, and related production.
          </p>
          <p>
            Our primary business is industrial static elimination, especially ionizing bars for machine and line integration. Industrial cleaning machines are our second product line, with automation integration retained as a supporting engineering capability. We focus on stable performance and long-term cooperation with global customers.
          </p>

          <div class="about-intro-points">
            <div class="about-point">
              <strong>Core Products</strong>
              <span>Static eliminators and ionizing bars first; industrial cleaning machines second</span>
            </div>
            <div class="about-point">
              <strong>Manufacturing Focus</strong>
              <span>Quality control, practical engineering, stable industrial performance</span>
            </div>
            <div class="about-point">
              <strong>Service Goal</strong>
              <span>Reliable support for long-term industrial cooperation</span>
            </div>
          </div>
        </div>

       <div class="about-image-stack" data-aos="fade-left" data-aos-duration="700">
  <picture><source srcset="/assets/img/about/about-lobby.webp" type="image/webp" /><img src="/assets/img/about/about-lobby.jpg" alt="Reception lobby at the Shidike factory in Dongguan, Guangdong" class="about-main-image" width="1400" height="840" loading="eager" decoding="async" fetchpriority="high" /></picture>
  <picture><source srcset="/assets/img/about/about-workshop-1.webp" type="image/webp" /><img src="/assets/img/about/about-workshop-1.jpg" alt="Shidike factory floor with cleaning machines" class="about-float-image" width="1400" height="840" loading="lazy" decoding="async" /></picture>
</div>
        </div>
      </div>
    </div>
  </section>

  <section class="about-values-section">
    <div class="container">
      <div class="about-section-heading text-center">
        <span class="about-section-label">Why Choose Us</span>
        <h2 data-aos="fade-up" data-aos-duration="700">Built around industrial reliability.</h2>
        <p>
          We focus on what matters most in manufacturing environments: consistency, efficiency,
          quality control, responsive support, and practical cooperation.
        </p>
      </div>

      <div class="about-values-grid">
        <div class="about-value-card" data-aos="fade-up" data-aos-delay="0" data-aos-duration="600">
          <img src="/assets/img/about/about-support.png" alt="Technical support icon" class="about-value-icon" loading="lazy" />
          <h3>Professional Support</h3>
          <p>
            We provide responsive communication and practical technical support for product selection and project discussion.
          </p>
        </div>

        <div class="about-value-card" data-aos="fade-up" data-aos-delay="80" data-aos-duration="600">
          <img src="/assets/img/about/icon-delivery.png" alt="Delivery and shipping support icon" class="about-value-icon" loading="lazy" />
          <h3>Reliable Delivery</h3>
          <p>
            Stable production management helps us support on-time delivery and efficient manufacturing coordination.
          </p>
        </div>

        <div class="about-value-card" data-aos="fade-up" data-aos-delay="160" data-aos-duration="600">
          <img src="/assets/img/about/icon-guarantee.png" alt="Quality assurance icon" class="about-value-icon" loading="lazy" />
          <h3>Quality Assurance</h3>
          <p>
            We focus on product consistency, inspection standards, and dependable industrial performance.
          </p>
        </div>

        <div class="about-value-card" data-aos="fade-up" data-aos-delay="240" data-aos-duration="600">
          <img src="/assets/img/about/icon-support.png" alt="Cooperation and after-sales service icon" class="about-value-icon" loading="lazy" />
          <h3>Long-Term Cooperation</h3>
          <p>
            Our goal is to build stable and lasting partnerships with global industrial customers.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="about-products-section">
    <div class="container">
      <div class="about-section-heading text-center">
        <span class="about-section-label">Our Business</span>
        <h2 data-aos="fade-up" data-aos-duration="700">Two core product lines, with integration support.</h2>
        <p>
          Industrial static control is our primary direction, cleaning machines are second, and line integration supports both.
        </p>
      </div>

      <div class="about-business-grid">
        <a href="/products/static-eliminator" class="about-business-card" data-aos="fade-up" data-aos-delay="0" data-aos-duration="600">
          <picture><source srcset="/assets/img/static-white-bg.webp" type="image/webp" /><img src="/assets/img/static-white-bg.png" alt="Shidike static elimination product range, ionizing bars and air blowers" loading="lazy" /></picture>
          <h3>1. Static Eliminators &amp; Ionizing Bars</h3>
          <p>Ion bars, ion fans, and electrostatic control solutions for sensitive industrial environments.</p>
        </a>

        <a href="/products/cleaning-machine" class="about-business-card" data-aos="fade-up" data-aos-delay="80" data-aos-duration="600">
          <picture><source srcset="/assets/img/cleaning-machine/polarizer-cleaner.webp" type="image/webp" /><img src="/assets/img/cleaning-machine/polarizer-cleaner.jpg" alt="Shidike polarizer precision cleaning machine for optical film" loading="lazy" /></picture>
          <h3>2. Industrial Cleaning Machines</h3>
          <p>Precision cleaning equipment for PCB, FPC, SMT, polarizer, LCM, backlight, and optical film applications.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="about-gallery-section">
    <div class="container">
      <div class="about-section-heading text-center">
        <span class="about-section-label">Factory Gallery</span>
        <h2 data-aos="fade-up" data-aos-duration="700">Inside our production environment.</h2>
        <p>
          Real equipment, real manufacturing, and real industrial working conditions.
        </p>
      </div>

      <div class="about-gallery-grid">
        <div class="about-gallery-item" data-aos="zoom-in" data-aos-delay="0" data-aos-duration="600">
          <picture><source srcset="/assets/img/about/about-workshop-1.webp" type="image/webp" /><img src="/assets/img/about/about-workshop-1.jpg" alt="Shidike cleaning machine showroom — finished products" width="1400" height="840" loading="lazy" decoding="async" /></picture>
        </div>
        <div class="about-gallery-item" data-aos="zoom-in" data-aos-delay="80" data-aos-duration="600">
          <picture><source srcset="/assets/img/about/about-workshop-2.webp" type="image/webp" /><img src="/assets/img/about/about-workshop-2.jpg" alt="Shidike factory assembly line" width="1400" height="840" loading="lazy" decoding="async" /></picture>
        </div>
        <div class="about-gallery-item" data-aos="zoom-in" data-aos-delay="160" data-aos-duration="600">
          <picture><source srcset="/assets/img/about/about-workshop-3.webp" type="image/webp" /><img src="/assets/img/about/about-workshop-3.jpg" alt="Shidike technicians assembling cleaning machines" width="1400" height="840" loading="lazy" decoding="async" /></picture>
        </div>
        <div class="about-gallery-item" data-aos="zoom-in" data-aos-delay="240" data-aos-duration="600">
          <picture><source srcset="/assets/img/about/about-training.webp" type="image/webp" /><img src="/assets/img/about/about-training.jpg" alt="Shidike training and meeting room" width="1400" height="840" loading="lazy" decoding="async" /></picture>
        </div>
      </div>
    </div>
  </section>
  <style>
    .about-values-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 22px;
    }

    .about-value-card {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-start;
    }

    .about-value-icon {
      width: 84px;
      height: 84px;
      object-fit: contain;
      display: block;
      margin: 0 0 18px;
      opacity: 0.92;
    }

    .about-gallery-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 22px;
    }

    .about-gallery-item {
      overflow: hidden;
      border-radius: 18px;
      background: #f7f8fa;
      box-shadow: 0 14px 36px rgba(15, 23, 42, 0.08);
    }

    .about-image-stack picture,
    .about-gallery-item picture {
      display: block;
      width: 100%;
      height: 100%;
    }

    .about-main-image,
    .about-float-image,
    .about-gallery-item img {
      width: 100%;
      object-fit: cover;
      display: block;
      image-rendering: auto;
      transform: translateZ(0);
      backface-visibility: hidden;
    }

    .about-gallery-item img {
      height: 320px;
      border-radius: 18px;
    }

    @media (max-width: 991px) {
      .about-values-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 768px) {
      .about-hero {
        background-attachment: scroll !important;
        background-position: center top !important;
      }

      .about-values-grid,
      .about-gallery-grid {
        grid-template-columns: 1fr;
      }

      .about-main-image {
        height: 300px;
        object-position: center center;
      }

      .about-value-icon {
        width: 72px;
        height: 72px;
      }

      .about-gallery-item img {
        height: 280px;
      }
    }
  </style>

  <section class="about-timeline-section">
    <div class="container">
      <div class="about-section-heading text-center">
        <span class="about-section-label">Our Development</span>
        <h2>Growing with industrial customers.</h2>
        <p>
          A development path focused on engineering capability, manufacturing reliability, and long-term service value.
        </p>
      </div>

      <div class="about-timeline">
        <div class="about-timeline-line"></div>

        <div class="about-timeline-item left" data-aos="fade-right" data-aos-duration="700">
          <div class="about-timeline-dot">01</div>
          <div class="about-timeline-card">
            <h3>Company Foundation</h3>
            <p>
              Established in Dongguan to develop practical industrial equipment for manufacturing customers.
            </p>
          </div>
        </div>

        <div class="about-timeline-item right" data-aos="fade-left" data-aos-duration="700">
          <div class="about-timeline-dot">02</div>
          <div class="about-timeline-card">
            <h3>Product Expansion</h3>
            <p>
              Expanded into static elimination systems and precision cleaning equipment for electronics and display industries.
            </p>
          </div>
        </div>

        <div class="about-timeline-item left" data-aos="fade-right" data-aos-duration="700">
          <div class="about-timeline-dot">03</div>
          <div class="about-timeline-card">
            <h3>Manufacturing Capability</h3>
            <p>
              Focused the product strategy on static eliminators and ionizing bars first, cleaning machines second, and integration support where needed.
            </p>
          </div>
        </div>

        <div class="about-timeline-item right" data-aos="fade-left" data-aos-duration="700">
          <div class="about-timeline-dot">04</div>
          <div class="about-timeline-card">
            <h3>Global Cooperation</h3>
            <p>
              Serving customers with stable quality, engineering support, and long-term cooperation for overseas markets.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="about-cta-section">
    <div class="container">
      <div class="about-cta-box" data-aos="fade-up" data-aos-duration="700">
        <div class="about-cta-copy">
          <span class="about-section-label">Work With Us</span>
          <h2>Looking for a reliable industrial manufacturing partner?</h2>
          <p>
            Contact Shidike to discuss your project, product requirements, or customized industrial solution.
          </p>
        </div>

        <div class="about-cta-actions">
          <a href="/contact" class="about-cta-btn primary">Contact Us</a>
          <a href="/products/static-eliminator" class="about-cta-btn secondary">Industrial Static Eliminators</a>
          <a href="/static-eliminator-manufacturer" class="about-cta-btn secondary">Manufacturing &amp; Customisation</a>
        </div>
      </div>
    </div>
  </section>

  <style>
    /* styles.css still lays this out as a 4-column grid from when there were four
       product lines. With two cards left they sat in columns 1-2 and the row read
       as left-aligned with a hole on the right. */
    .about-business-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
      max-width: 780px;
      margin-inline: auto;
    }
    @media (max-width: 640px) {
      .about-business-grid { grid-template-columns: 1fr !important; max-width: 420px; }
    }
  </style>
</Layout>
