---
// "Explore by topic" — filter chips over the full card grid.
//
// The filter is presentation only: every card is rendered server-side as a real
// <a href>, and filtering just hides cards. Nothing here is generated by script,
// so a crawler (or a visitor with JS off) still sees every article.
const { eyebrow, heading, lead, items, categories, kind } = Astro.props;
---

<section class="rx-grid-section">
  <div class="container rx-wrap">
    <div class="rx-grid-head">
      <div>
        <p class="rx-eyebrow">{eyebrow}</p>
        <h2>{heading}</h2>
      </div>
      <p class="rx-grid-lead">{lead}</p>
    </div>

    <div class="rx-filters" role="group" aria-label="Filter by topic">
      {categories.map((cat, i) => (
        <button type="button" class:list={['rx-chip', i === 0 && 'is-active']} data-filter={cat} aria-pressed={i === 0 ? 'true' : 'false'}>{cat}</button>
      ))}
    </div>

    <p class="rx-count" data-count>{items.length} resources</p>

    <div class="rx-cards">
      {items.map((item) => (
        <a class="rx-card" href={item.href} data-category={item.category}>
          <picture class="rx-card-media">
            <source srcset={`${item.image}.webp`} type="image/webp" />
            <img src={`${item.image}.jpg`} alt="" loading="lazy" decoding="async" width="480" height="270" />
          </picture>
          <div class="rx-card-body">
            <p class="rx-card-cat">{kind} &middot; {item.category}</p>
            <h3>{item.title}</h3>
            <p class="rx-card-desc">{item.excerpt}</p>
            <span class="rx-textlink">Read the article <span aria-hidden="true">&#8594;</span></span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var section = document.currentScript.previousElementSibling;
    if (!section) return;
    var chips = section.querySelectorAll('.rx-chip');
    var cards = section.querySelectorAll('.rx-card');
    var count = section.querySelector('[data-count]');

    chips.forEach(function (chip) {
      chip.addEventListener('click', function () {
        var want = chip.getAttribute('data-filter');
        var shown = 0;
        chips.forEach(function (c) {
          var on = c === chip;
          c.classList.toggle('is-active', on);
          c.setAttribute('aria-pressed', on ? 'true' : 'false');
        });
        cards.forEach(function (card) {
          var match = want === 'All' || card.getAttribute('data-category') === want;
          card.hidden = !match;
          if (match) shown += 1;
        });
        if (count) count.textContent = shown + (shown === 1 ? ' resource' : ' resources');
      });
    });
  })();
</script>
