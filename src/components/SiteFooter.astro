   'M5.2 3.2a2 2 0 1 0 0 4 2 2 0 0 0 0-4ZM3.5 9h3.4v12H3.5Zm5.6 0h3.2v1.6h.1c.5-.9 1.6-1.9 3.4-1.9 3.6 0 4.2 2.3 4.2 5.3v7h-3.4v-6.2c0-1.5 0-3.3-2-3.3s-2.2 1.6-2.2 3.2V21H9.1Z'],
