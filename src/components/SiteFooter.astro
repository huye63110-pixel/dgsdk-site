   'M14 21v-8h2.8l.5-3H14V8.1c0-.9.3-1.6 1.6-1.6h1.9V3.8c-.3 0-1.4-.1-2.7-.1-2.7 0-4.5 1.6-4.5 4.5V10h-3v3h3v8Z'],
