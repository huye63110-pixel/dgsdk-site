  ['Email', 'mailto:dgsdk2013@gmail.com',
   'M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm9 8 8-5V7l-8 5-8-5v1Z'],
