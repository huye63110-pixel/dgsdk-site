---
// Shared site footer — one copy, rendered by Layout.astro for every page.
//
// White ground, matching the header. Social icons are inline SVG rather than
// icon-font glyphs so the row survives a Font Awesome failure.
//
// Contact details here are the ones from PR #9 and #10 and must stay in step
// with the Organization/LocalBusiness JSON-LD in Layout.astro.
import { WHATSAPP, social } from '../data/social.js';

const quickLinks = [
  ['/', 'Home'],
  ['/applications', 'Applications'],
  ['/resources', 'Resources'],
  ['/guides', 'Guides'],
  ['/blog', 'Blog'],
  ['/about', 'About Us'],
  ['/contact', 'Contact Us'],
  ['/faq', 'FAQ'],
];

const productLinks = [
  ['/products/static-eliminator', 'Static Eliminators & Ionizing Bars'],
  ['/products/cleaning-machine', 'Industrial Cleaning Machines'],
];

---

<footer class="homepage-footer" id="site-footer">
  <div class="container hf-content">
    <div class="hf-grid">
      <div class="hf-brand">
        <a href="/" aria-label="Shidike home">
          <img src="/logo.png" alt="Shidike" width="600" height="168" loading="lazy" />
        </a>
        <p>Shidike builds industrial static eliminators and ionizing bars as its primary line, supported by precision contact cleaning machines for production lines worldwide.</p>
      </div>

      <nav class="hf-column" aria-labelledby="hf-quick-title">
        <h2 id="hf-quick-title">Quick Links</h2>
        <ul>{quickLinks.map(([href, label]) => <li><a href={href}>{label}</a></li>)}</ul>
      </nav>

      <nav class="hf-column" aria-labelledby="hf-products-title">
        <h2 id="hf-products-title">Products</h2>
        <ul>{productLinks.map(([href, label]) => <li><a href={href}>{label}</a></li>)}</ul>
      </nav>

      <div class="hf-column hf-contact">
        <h2>Contact</h2>
        <address>
          <p><span>Phone:</span> <a href="tel:+8613602342003">+86 13602342003</a></p>
          <p><span>WhatsApp:</span> <a href={WHATSAPP} target="_blank" rel="noopener noreferrer">+61 403454968</a></p>
          <p><span>Email:</span> <a href="mailto:dgsdk2013@gmail.com">dgsdk2013@gmail.com</a></p>
          <p><span>Address:</span> Room 101, Building 1, No. 33 Binhe Road, Zhangmutou Town, Dongguan, Guangdong, China</p>
        </address>
      </div>
    </div>

    <div class="hf-follow" aria-labelledby="hf-follow-title">
      <h2 id="hf-follow-title">Follow Us</h2>
      <div class="hf-social">
        {social.map(([label, href, d]) => (
          <a href={href} target="_blank" rel="noopener noreferrer" aria-label={label} title={label} class="hf-social-link">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={d} /></svg>
          </a>
        ))}
      </div>
    </div>

    <div class="hf-bottom">
      <p>© 2026 Dongguan Shidike Intelligent Equipment Co., Ltd. All rights reserved.</p>
      <a href="/privacy">Privacy Policy</a>
    </div>
  </div>
</footer>
