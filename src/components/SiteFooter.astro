const quickLinks = [
  ['/', 'Home'],
  ['/applications', 'Applications'],
  ['/guides', 'Guides'],
  ['/blog', 'Blog'],
  ['/about', 'About Us'],
  ['/contact', 'Contact Us'],
  ['/faq', 'FAQ'],
];

const productLinks = [
  ['/products/static-eliminator', 'Static Eliminators & Ionizing Bars'],
  ['/products/cleaning-machine', 'Industrial Cleaning Machines'],
